#!/bin/sh
# ==============================================================================
# MicronOS — GRUB A/B Boot Slot Selector (grub-mkconfig fragment)
# ==============================================================================
# Installed as /etc/grub.d/09_micron_slots. It runs during `grub-mkconfig` (i.e.
# inside `update-grub`) and prints the boot-slot logic into grub.cfg. Because it
# sorts before 10_linux, its menuentry is index 0 and therefore the default; the
# distribution-generated entries remain available further down the menu as a
# rescue path.
#
# The selector deliberately does no arithmetic: GRUB script has no reliable
# integer maths, so the environment block carries plain booleans and the
# health-check service (which runs in a full shell) owns every counter. GRUB only
# ever answers "is the preferred slot proven, and if not, is the other one?".
#
# Resolution of the slot UUIDs and the kernel happens here, at generation time,
# so the emitted config contains concrete values with no runtime lookups.
#
# Overridable for testing (no need to run grub-mkconfig on the real target):
#   MICRON_UUID_A, MICRON_UUID_B, MICRON_KERNEL, MICRON_INITRD, MICRON_CMDLINE
# ==============================================================================

set -eu

resolve_uuid() { # resolve_uuid <label> [override_uuid]
    if [ -n "${2:-}" ]; then
        printf '%s' "$2"
        return 0
    fi
    local dev
    dev=$(blkid -L "$1" 2>/dev/null || true)
    if [ -n "$dev" ]; then
        blkid -s UUID -o value "$dev" 2>/dev/null || true
        return 0
    fi
    blkid -t LABEL="$1" -s UUID -o value 2>/dev/null || true
}

UUID_A=$(resolve_uuid 'MICRON_ROOT_A' "${MICRON_UUID_A:-}")
UUID_B=$(resolve_uuid 'MICRON_ROOT_B' "${MICRON_UUID_B:-}")

# Newest installed kernel, as an absolute path on the slot's root filesystem;
# falls back to the Debian symlink when no versioned kernel is present.
resolve_kernel() {
    local newest
    newest=$(ls -1 /boot/vmlinuz-* 2>/dev/null | sort -V | tail -1 || true)
    if [ -n "$newest" ]; then
        printf '%s' "$newest"
        return 0
    fi
    printf '%s' '/vmlinuz'
}

KERNEL="${MICRON_KERNEL:-$(resolve_kernel)}"
if [ -n "${MICRON_INITRD:-}" ]; then
    INITRD="$MICRON_INITRD"
else
    INITRD=$(printf '%s' "$KERNEL" | sed 's/vmlinuz/initrd.img/')
fi
CMDLINE="${MICRON_CMDLINE:-ro quiet}"

echo "### BEGIN /etc/grub.d/09_micron_slots ###"
echo "# Generated by MicronOS — A/B boot slot selector."
echo "# Slot A root: ${UUID_A:-<unresolved>}"
echo "# Slot B root: ${UUID_B:-<unresolved>}"

if [ -z "$UUID_A" ]; then
    echo "# WARNING: no partition labelled MICRON_ROOT_A found; leaving the"
    echo "# distribution menu entries as the only boot path."
    echo "### END /etc/grub.d/09_micron_slots ###"
    exit 0
fi

cat << 'GRUB_HEAD'
# Load the environment block written by micron-slot (active slot + good marks).
load_env

set micron_slot="${micron_active_slot}"
if [ "$micron_slot" != "b" ]; then
    set micron_slot="a"
fi

# Prefer a slot that a previous boot proved healthy.
set micron_target=""
if [ "$micron_slot" = "b" ]; then
    if [ "$micron_b_ok" = "1" ]; then
        set micron_target="b"
    fi
else
    if [ "$micron_a_ok" = "1" ]; then
        set micron_target="a"
    fi
fi

# Preferred slot is not trusted: fall back to the other one if it is.
if [ "$micron_target" = "" ]; then
    if [ "$micron_slot" = "b" ]; then
        if [ "$micron_a_ok" = "1" ]; then
            set micron_target="a"
        fi
    else
        if [ "$micron_b_ok" = "1" ]; then
            set micron_target="b"
        fi
    fi
fi

# Neither slot is trusted (fresh install, or every slot has failed): boot the
# active slot anyway so the appliance stays reachable and the health check can
# record what went wrong.
if [ "$micron_target" = "" ]; then
    set micron_target="$micron_slot"
fi

# Emergency Keyboard Intercept (Esc or Shift) -> auto-select recovery
if keystatus --escape; then
    set default="micronos-recovery"
fi
if keystatus --shift; then
    set default="micronos-recovery"
fi
GRUB_HEAD

cat << GRUB_BOOT
function micron_boot {
    if [ "\$1" = "b" ]; then
        search --no-floppy --fs-uuid --set=root ${UUID_B}
        linux  ${KERNEL} root=UUID=${UUID_B} ${CMDLINE}
        initrd ${INITRD}
    else
        search --no-floppy --fs-uuid --set=root ${UUID_A}
        linux  ${KERNEL} root=UUID=${UUID_A} ${CMDLINE}
        initrd ${INITRD}
    fi
}
GRUB_BOOT

echo ''
echo 'menuentry "Micron OS (auto slot)" --id micronos-auto {'
echo '    micron_boot $micron_target'
echo '}'

if [ -n "$UUID_B" ]; then
    echo ''
    echo 'menuentry "Micron OS (LKGC - alternate slot)" --id micronos-lkgc {'
    echo '    if [ "$micron_target" = "a" ]; then'
    echo '        micron_boot b'
    echo '    else'
    echo '        micron_boot a'
    echo '    fi'
    echo '}'
fi

echo ''
echo 'menuentry "Micron OS (slot A, manual)" --id micronos-slot-a {'
echo '    micron_boot a'
echo '}'

if [ -n "$UUID_B" ]; then
    echo ''
    echo 'menuentry "Micron OS (slot B, manual)" --id micronos-slot-b {'
    echo '    micron_boot b'
    echo '}'
else
    echo ''
    echo '# Slot B is unformatted/unlabelled: no manual entry emitted.'
fi

echo ''
echo 'menuentry "Micron OS (factory recovery - pristine boot)" --id micronos-factory {'
echo '    if [ "$micron_target" = "b" ]; then'
if [ -n "$UUID_B" ]; then
    echo "        search --no-floppy --fs-uuid --set=root ${UUID_B}"
    echo "        linux  ${KERNEL} root=UUID=${UUID_B} ro micron_factory_reset=1 quiet"
    echo "        initrd ${INITRD}"
else
    echo "        search --no-floppy --fs-uuid --set=root ${UUID_A}"
    echo "        linux  ${KERNEL} root=UUID=${UUID_A} ro micron_factory_reset=1 quiet"
    echo "        initrd ${INITRD}"
fi
echo '    else'
echo "        search --no-floppy --fs-uuid --set=root ${UUID_A}"
echo "        linux  ${KERNEL} root=UUID=${UUID_A} ro micron_factory_reset=1 quiet"
echo "        initrd ${INITRD}"
echo '    fi'
echo '}'

echo ''
echo 'menuentry "Micron OS (failsafe maintenance shell)" --id micronos-recovery {'
echo "    search --no-floppy --fs-uuid --set=root ${UUID_A}"
echo "    linux  ${KERNEL} root=UUID=${UUID_A} ro single init=/bin/bash"
echo "    initrd ${INITRD}"
echo '}'

echo "### END /etc/grub.d/09_micron_slots ###"
