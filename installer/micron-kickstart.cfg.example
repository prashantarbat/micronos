# ==============================================================================
# Micron OS — Automated Kickstart Installation Configuration (ks.cfg)
# ==============================================================================
# This file enables completely unattended, zero-touch automated installation
# of Micron Firewall OS for bare-metal appliances, virtual machines, and clusters.
#
# Usage Methods:
# 1. Place this file named 'micron-kickstart.cfg' or 'ks.cfg' on the root of your
#    installation USB flash drive or ISO.
# 2. Or pass it as a kernel boot argument in GRUB:
#      micron.kickstart=/path/to/micron-kickstart.cfg
#    Or via network URL (PXE / HTTP / TFTP):
#      micron.ks=http://192.168.1.50/micron-kickstart.cfg
# 3. Or run directly from terminal:
#      ./install.sh --kickstart /path/to/micron-kickstart.cfg
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Keyboard Layout & Localization
# ------------------------------------------------------------------------------
# Supported values: us, uk, de, fr, es, it, br, jp, pl, ru, se
KEYMAP="us"

# ------------------------------------------------------------------------------
# 2. System Timezone
# ------------------------------------------------------------------------------
# Standard Olson timezone name (e.g. UTC, Asia/Kolkata, America/New_York, Europe/London)
TIMEZONE="Asia/Kolkata"

# ------------------------------------------------------------------------------
# 3. Target Storage Disk
# ------------------------------------------------------------------------------
# 'auto' or 'first' : Automatically select first suitable internal drive (>= 27 GB)
# Or specify disk device explicitly: /dev/sda, /dev/nvme0n1, /dev/vda
TARGET_DISK="auto"

# ------------------------------------------------------------------------------
# 4. Storage Partitioning Strategy & Sizing
# ------------------------------------------------------------------------------
# PART_STRATEGY:
#   1 : Guided A/B Dual Slot Appliance (Recommended: ESP + Swap + Root A + Root B + Data)
# SLOT_SIZE: Size allocated to each Root Slot partition (Slot A and Slot B)
#   Default: 10G (e.g. 10G, 16G, 20G)
PART_STRATEGY="1"
SLOT_SIZE="10G"

# ------------------------------------------------------------------------------
# 5. Administrative Credentials
# ------------------------------------------------------------------------------
# Unified password for Web GUI ('Ministrator') and OS ('root', 'ministrator').
# There is no default. At least 8 characters; the published factory password
# (M1Cr0N) is refused. Leave empty to generate a random password, which is
# shown at the end of the install and saved to /etc/micron/initial-admin-password.
ADMIN_PW=""

# ------------------------------------------------------------------------------
# 6. Automatic Reboot Behavior
# ------------------------------------------------------------------------------
# 'yes' : Automatically reboot appliance after successful installation (5s countdown)
# 'no'  : Remain on completion screen without rebooting
REBOOT="yes"

# ------------------------------------------------------------------------------
# 7. Optional Initial Network Configuration
# ------------------------------------------------------------------------------
# Leave empty to auto-assign physical NIC 1 as WAN and NIC 2 as LAN at boot.
# Additional physical ports remain independent and can be assigned as OPT interfaces.
# Or pre-assign interfaces for instant headless web management access:
#
# --- Simple (single physical LAN port) ---
# WAN_IF="eth0"
# LAN_IF="eth1"
# LAN_IP="10.10.10.10"
# LAN_NETMASK="255.255.255.0"
#
WAN_IF=""
LAN_IF=""
LAN_IP="10.10.10.10"
LAN_NETMASK="255.255.255.0"

