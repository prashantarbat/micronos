#!/bin/bash
# ==============================================================================
# Micron OS — pfSense-Style Interactive Console Management Menu
# ==============================================================================
# Provides console and SSH operators with an interactive management interface
# mirroring enterprise appliances (pfSense, OPNsense, FortiOS).
# Open Source under Apache License 2.0
# ==============================================================================
#
# DELIBERATELY NO `set -e`.
#
# This is an interactive menu. Under `set -e` the first command that returns
# non-zero anywhere in a handler — a `systemctl stop` on an already-stopped
# unit, a `microctl` call that reports a validation error, `htop` exiting with
# a status, or `read` hitting EOF — silently terminated the whole menu script.
# Because /etc/profile.d/micron-menu.sh is the last thing the login shell does,
# terminating the script also ended the console session: agetty respawned the
# autologin, cleared the screen and redrew the banner and menu. Operators read
# that as "the appliance restarted whatever option I picked".
#
# A failure inside a menu action must be reported to the operator and return to
# the menu. It must never abort the menu and it must NEVER reboot the machine.
# ==============================================================================

# Prevent re-entrant menu loops in child shells
export IN_MICRON_MENU=1

# Ctrl+C / SIGTERM inside the menu must return to the menu, not kill the session.
# (Defined after the main loop; see the bottom of this file.)
MENU_QUIT=0

# Terminal colors
BOLD='\033[1m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

app_root="/usr/local/micron"
[ -d "$app_root" ] || app_root="$(cd "$(dirname "$0")/.." && pwd)"

# Privilege helper
run_root() {
    if [ "$EUID" -eq 0 ]; then
        "$@"
    elif command -v sudo >/dev/null 2>&1; then
        sudo "$@"
    else
        "$@"
    fi
}

# ------------------------------------------------------------------------------
# NUM LOCK Enforcement Helper (Always ON at CLI layer)
# ------------------------------------------------------------------------------
ensure_numlock() {
    if command -v setleds >/dev/null 2>&1; then
        setleds -D +num 2>/dev/null || true
        if [ "${EUID:-$(id -u)}" -eq 0 ]; then
            for tty in /dev/tty[1-6] /dev/tty0 /dev/console; do
                if [ -e "$tty" ] && [ -r "$tty" ] && [ -w "$tty" ]; then
                    { setleds -D +num < "$tty"; } 2>/dev/null || true
                fi
            done
        fi
    fi
}

# Function to refresh network and slot info
get_network_info() {
    HOSTNAME=$(hostname 2>/dev/null || echo "micron-os")
    if [ "$HOSTNAME" = "debian" ] || [ -z "$HOSTNAME" ]; then
        HOSTNAME="micron-os"
        run_root hostname "$HOSTNAME" 2>/dev/null || true
        run_root bash -c 'echo "micron-os" > /etc/hostname' 2>/dev/null || true
    fi

    # 1. Detect WAN Interface
    WAN_IF=""
    if [ -f /etc/micron/network_init.json ]; then
        WAN_IF=$(grep -o '"wan_interface"[[:space:]]*:[[:space:]]*"[^"]*"' /etc/micron/network_init.json 2>/dev/null | cut -d'"' -f4 || true)
    fi
    if [ -z "$WAN_IF" ] || [ ! -d "/sys/class/net/$WAN_IF" ]; then
        WAN_IF=$(ip route show default 2>/dev/null | awk '/default/ {print $5}' | head -n1 || true)
    fi
    if [ -z "$WAN_IF" ] && [ -d /sys/class/net ]; then
        WAN_IF=$(ls -1 /sys/class/net 2>/dev/null | grep -E -v '^(lo|virbr|docker|veth|wg|tun)' | head -n1 || echo "eth0")
    fi
    [ -n "$WAN_IF" ] || WAN_IF="eth0"

    # 2. Detect LAN Interface
    LAN_IF=""
    if [ -f /etc/micron/network_init.json ]; then
        LAN_IF=$(grep -o '"lan_interface"[[:space:]]*:[[:space:]]*"[^"]*"' /etc/micron/network_init.json 2>/dev/null | cut -d'"' -f4 || true)
    fi
    if [ -z "$LAN_IF" ] || [ ! -d "/sys/class/net/$LAN_IF" ]; then
        if [ -d /sys/class/net ]; then
            LAN_IF=$(ls -1 /sys/class/net 2>/dev/null | grep -E -v '^(lo|virbr|docker|veth|wg|tun)' | grep -v "^${WAN_IF}$" | head -n1 || true)
        fi
    fi
    [ -n "$LAN_IF" ] || LAN_IF="$WAN_IF"

    # 3. Resolve WAN IP (filter 169.254, settle for up to 3s if DHCP in flight)
    WAN_IP=$(ip -4 addr show dev "$WAN_IF" 2>/dev/null | awk '/inet / && !/169\.254/ {print $2}' | head -n1 || true)
    if [ -z "$WAN_IP" ]; then
        for _ in 1 2 3; do
            sleep 1
            WAN_IP=$(ip -4 addr show dev "$WAN_IF" 2>/dev/null | awk '/inet / && !/169\.254/ {print $2}' | head -n1 || true)
            [ -n "$WAN_IP" ] && break
        done
    fi
    [ -n "$WAN_IP" ] || WAN_IP="DHCP (Requesting...)"

    # 4. Resolve LAN IP
    LAN_IP=$(ip -4 addr show dev "$LAN_IF" 2>/dev/null | awk '/inet / && !/169\.254/ {print $2}' | head -n1 || true)
    DB_LAN_MODE="static"
    if [ -f "/usr/local/micron/writable/micron_config.db" ] && command -v sqlite3 >/dev/null 2>&1; then
        DB_LAN_MODE=$(sqlite3 /usr/local/micron/writable/micron_config.db "SELECT ip_assignment_type FROM interfaces WHERE id='lan' AND enabled=1;" 2>/dev/null || echo "static")
    fi

    if [ -z "$LAN_IP" ]; then
        if [ "$DB_LAN_MODE" = "dhcp" ]; then
            for _ in 1 2 3; do
                sleep 1
                LAN_IP=$(ip -4 addr show dev "$LAN_IF" 2>/dev/null | awk '/inet / && !/169\.254/ {print $2}' | head -n1 || true)
                [ -n "$LAN_IP" ] && break
            done
            [ -n "$LAN_IP" ] || LAN_IP="DHCP (Requesting...)"
        else
            DB_LAN_IP=""
            if [ -f "/usr/local/micron/writable/micron_config.db" ] && command -v sqlite3 >/dev/null 2>&1; then
                DB_LAN_IP=$(sqlite3 /usr/local/micron/writable/micron_config.db "SELECT ipv4_address || '/' || ipv4_netmask FROM interfaces WHERE id='lan' AND enabled=1;" 2>/dev/null || true)
            fi
            if [ -n "$DB_LAN_IP" ] && [ "$DB_LAN_IP" != "/" ]; then
                TARGET_LAN_IP="$DB_LAN_IP"
            else
                TARGET_LAN_IP="10.10.10.10/24"
            fi

            if [ "$LAN_IF" != "$WAN_IF" ]; then
                LL_ADDR=$(ip -4 addr show dev "$LAN_IF" 2>/dev/null | awk '/inet 169\.254/ {print $2}' | head -n1 || true)
                if [ -n "$LL_ADDR" ]; then
                    run_root ip addr del "$LL_ADDR" dev "$LAN_IF" 2>/dev/null || true
                fi
                run_root ip addr add "$TARGET_LAN_IP" dev "$LAN_IF" 2>/dev/null || true
                run_root ip link set dev "$LAN_IF" up 2>/dev/null || true
                LAN_IP=$(ip -4 addr show dev "$LAN_IF" 2>/dev/null | awk '/inet / && !/169\.254/ {print $2}' | head -n1 || echo "$TARGET_LAN_IP")
            else
                LAN_IP="$TARGET_LAN_IP"
            fi
        fi
    fi

    # 5. Carrier Link Status
    WAN_LINK="UP"
    if [ -f "/sys/class/net/$WAN_IF/carrier" ] && [ "$(cat "/sys/class/net/$WAN_IF/carrier" 2>/dev/null)" = "0" ]; then
        WAN_LINK="NO LINK"
    fi
    LAN_LINK="UP"
    if [ -f "/sys/class/net/$LAN_IF/carrier" ] && [ "$(cat "/sys/class/net/$LAN_IF/carrier" 2>/dev/null)" = "0" ]; then
        LAN_LINK="NO LINK"
    fi

    # 6. Management IP
    MGMT_IP=""
    LAN_CLEAN=$(echo "$LAN_IP" | cut -d/ -f1)
    WAN_CLEAN=$(echo "$WAN_IP" | cut -d/ -f1)

    if [ -n "$LAN_CLEAN" ] && [[ ! "$LAN_CLEAN" =~ ^(169\.254|DHCP) ]]; then
        MGMT_IP="$LAN_CLEAN"
    elif [ -n "$WAN_CLEAN" ] && [[ ! "$WAN_CLEAN" =~ ^(169\.254|DHCP) ]]; then
        MGMT_IP="$WAN_CLEAN"
    fi
    [ -n "$MGMT_IP" ] || MGMT_IP="10.10.10.10"

    # 7. Slot Info (resolve from the volume label of the mounted root)
    #
    # Resolve by filesystem LABEL, never by partition number. The A/B layout is
    #   1=ESP  2=BIOS-boot  3=swap  4=MICRON_ROOT_A  5=MICRON_ROOT_B  6=MICRON_DATA
    # so Slot A is p4, not p3, and the letter is identical on sda/sdb/vda/nvme0n1/
    # mmcblk0. A numbering-based guess reported the wrong slot on every fresh
    # install (it read p4 as "B"). micron-slot's GRUB environment is the second
    # authority; the raw device name is only a last-resort fallback.
    ROOT_DEV=$(findmnt -n -o SOURCE / 2>/dev/null || true)
    ROOT_LABEL=$(blkid -s LABEL -o value "$ROOT_DEV" 2>/dev/null || true)
    ACTIVE_SLOT=""
    case "$ROOT_LABEL" in
        MICRON_ROOT_A) ACTIVE_SLOT="A" ;;
        MICRON_ROOT_B) ACTIVE_SLOT="B" ;;
    esac
    if [ -z "$ACTIVE_SLOT" ]; then
        for slot_helper in /usr/local/bin/micron-slot /usr/local/micron/installer/micron-slot; do
            [ -x "$slot_helper" ] || continue
            s=$(MICRON_SLOT_ENV=/boot/grub/grubenv "$slot_helper" active 2>/dev/null || true)
            case "${s,,}" in
                a) ACTIVE_SLOT="A"; break ;;
                b) ACTIVE_SLOT="B"; break ;;
            esac
        done
    fi
    if [ -z "$ACTIVE_SLOT" ]; then
        case "$ROOT_DEV" in
            *p5|*5) ACTIVE_SLOT="B" ;;
            *p4|*4) ACTIVE_SLOT="A" ;;
            *)      ACTIVE_SLOT="A" ;;
        esac
    fi

    SLOT_STATUS="Healthy"
    if [ -x /usr/local/micron/installer/micron-slot ]; then
        fail_cnt=$(/usr/local/micron/installer/micron-slot fail-count "${ACTIVE_SLOT,,}" 2>/dev/null || echo "0")
        if [ "$fail_cnt" -gt 0 ]; then
            SLOT_STATUS="Unverified (${fail_cnt} failures)"
        fi
    fi

    # 8. Version & Architecture Resolution (following project VERSION mechanism)
    OS_VERSION=""
    if [ -f "$app_root/VERSION" ]; then
        OS_VERSION=$(head -n1 "$app_root/VERSION" | tr -d '[:space:]')
    elif [ -f "/usr/local/micron/VERSION" ]; then
        OS_VERSION=$(head -n1 "/usr/local/micron/VERSION" | tr -d '[:space:]')
    elif [ -f "/etc/micron/VERSION" ]; then
        OS_VERSION=$(head -n1 "/etc/micron/VERSION" | tr -d '[:space:]')
    elif [ -f "/etc/os-release" ]; then
        OS_VERSION=$(grep -E '^VERSION_ID=' /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d '"' || true)
    fi
    [ -n "$OS_VERSION" ] || OS_VERSION="0.1.23"

    OS_ARCH=$(uname -m 2>/dev/null || echo "amd64")
    [ "$OS_ARCH" = "x86_64" ] && OS_ARCH="amd64"
}

print_header() {
    ensure_numlock
    clear 2>/dev/null || true
    echo -e "${CYAN}"
    cat << 'BANNER'

┌╦═╦═╦┐ ┌═╤╦╤═┐ ┌╦═══╦┐ ┌╦═══╦┐ ┌╦═══╦┐ ┌╦═╗ ╦┐      ┌╦═══╦┐ ┌╦═══╦┐
│║ ║ ║│   │║│   │║      │╠══╦╩┘ │║   ║│ │║ ║ ║│      │║   ║│ └╩═══╦┐
└╩   ╩┘ └═╧╩╧═┘ └╩═══╩┘ └╩  ╚═┘ └╩═══╩┘ └╩ ╚═╩┘      └╩═══╩┘ └╩═══╩┘
 Enterprise Linux Firewall & Network Appliance
BANNER
    echo -e "${NC}"

    get_network_info

    echo -e "${BOLD}*** Welcome to Micron OS ${OS_VERSION} (${OS_ARCH}) on ${HOSTNAME} ***${NC}\n"
    if [ "$WAN_LINK" = "NO LINK" ]; then
        printf "  %-16s -> %-10s ${RED}[NO CARRIER]${NC} -> %s\n" "WAN (wan)" "$WAN_IF" "v4: $WAN_IP"
    else
        printf "  %-16s -> %-10s ${GREEN}[LINK UP]${NC}   -> %s\n" "WAN (wan)" "$WAN_IF" "v4: $WAN_IP"
    fi
    if [ "$LAN_LINK" = "NO LINK" ]; then
        printf "  %-16s -> %-10s ${RED}[NO CARRIER]${NC} -> %s\n" "LAN (lan)" "$LAN_IF" "v4: $LAN_IP"
    else
        printf "  %-16s -> %-10s ${GREEN}[LINK UP]${NC}   -> %s\n" "LAN (lan)" "$LAN_IF" "v4: $LAN_IP"
    fi
    printf "  %-16s -> %s\n" "Web Management" "http://${MGMT_IP}/ (Port 80)"
    printf "  %-16s -> Slot %s (%s)\n\n" "Active Root Slot" "$ACTIVE_SLOT" "$SLOT_STATUS"

    echo " 0) Logout (SSH only)                 10) Filter & System Logs"
    echo " 1) Assign Interfaces                 11) Restart Web GUI (Apache2)"
    echo " 2) Set interface(s) IP address       12) PHP Shell / App Console"
    echo " 3) Reset Web GUI password            13) Update & Firmware Manager"
    echo " 4) Reset to factory defaults         14) Toggle SSH Service"
    echo " 5) Reboot system                     15) Restore Configuration Backup"
    echo " 6) Halt system (Power off)           16) Restart micrond & PHP-FPM"
    echo " 7) Ping host                         17) A/B Boot Slot Rescue & Switch"
    echo " 8) Shell (Root Bash Prompt)          18) Bridge Interfaces (br0 Switch)"
    echo " 9) System Monitor (htop)             19) Enable/Disable DHCP"
    echo ""
}

pause() {
    echo ""
    read -r -p "Press [Enter] to return to main menu..." || true
    return 0
}

# ------------------------------------------------------------------------------
# Guard rails — the menu must never abort, and must never restart on its own
# ------------------------------------------------------------------------------
# Only menu_reboot() and menu_poweroff() below are permitted to take the
# appliance down, and they are reachable ONLY from the two options the operator
# selects deliberately (5 and 6). Every other handler reports its own failure
# and falls back through pause() to the main loop.

# Ctrl+C / SIGTERM during an action returns to the menu instead of ending the
# console session (which agetty would respawn, looking like a reboot).
menu_on_interrupt() {
    echo ""
    echo -e "${YELLOW}[i] Interrupted — returning to the main menu. Nothing was rebooted.${NC}"
    sleep 1
}

menu_reboot() {
    echo -e "${YELLOW}Rebooting appliance...${NC}"
    sync 2>/dev/null || true
    # Graceful first: systemd runs the full shutdown/stop job graph and the
    # journal records why the appliance went down. The forced paths are only a
    # fallback for a wedged PID 1.
    if run_root systemctl reboot 2>/dev/null; then
        return 0
    fi
    run_root reboot 2>/dev/null || run_root reboot -f 2>/dev/null || true
    return 0
}

menu_poweroff() {
    echo -e "${YELLOW}Shutting down appliance...${NC}"
    sync 2>/dev/null || true
    if run_root systemctl poweroff 2>/dev/null; then
        return 0
    fi
    run_root poweroff 2>/dev/null || run_root poweroff -f 2>/dev/null || true
    return 0
}

# ------------------------------------------------------------------------------
# Option 1: pfSense-Style Interface Assignment Handler
# ------------------------------------------------------------------------------
assign_interfaces_pfsense() {
    echo -e "\n${BOLD}=== 1) Assign Interfaces (pfSense-Style) ===${NC}\n"

    # Enumerate physical & VLAN network interfaces
    get_interfaces_table() {
        echo -e "${BOLD}Valid network interfaces:${NC}"
        printf "%-10s %-19s %-8s %-14s %s\n" "Interface" "MAC Address" "Link" "Speed" "Driver / Type"
        echo "--------------------------------------------------------------------------------"
        
        for ifpath in /sys/class/net/*; do
            [ -d "$ifpath" ] || continue
            local dev
            dev=$(basename "$ifpath")
            [[ "$dev" =~ ^(lo|virbr|docker|veth|wg|tun) ]] && continue
            
            local mac="00:00:00:00:00:00"
            [ -f "$ifpath/address" ] && mac=$(cat "$ifpath/address" 2>/dev/null || echo "00:00:00:00:00:00")
            
            local oper="DOWN"
            oper=$(ip -br link show dev "$dev" 2>/dev/null | awk '{print $2}' || echo "UNKNOWN")
            
            local spd="Auto / Virtual"
            if [ -f "$ifpath/speed" ]; then
                local s
                s=$(cat "$ifpath/speed" 2>/dev/null || echo "-1")
                if [ -n "$s" ] && [ "$s" -gt 0 ] 2>/dev/null; then
                    spd="${s} Mbps"
                fi
            fi
            
            local drv="Virtual / Generic"
            if [ -d "$ifpath/device/driver" ]; then
                drv=$(basename "$(readlink -f "$ifpath/device/driver" 2>/dev/null)" 2>/dev/null || echo "Generic")
            elif [[ "$dev" =~ \.[0-9]+$ ]]; then
                drv="802.1Q VLAN"
            elif [ -d "$ifpath/bridge" ]; then
                drv="Layer 2 Bridge"
            fi

            printf "%-10s %-19s %-8s %-14s %s\n" "$dev" "$mac" "$oper" "$spd" "$drv"
        done
        echo ""
    }

    get_interfaces_table

    # Step 1: Optional VLAN Setup
    read -r -p "Should VLANs be configured now [y/N]? " DO_VLAN
    if [ "$DO_VLAN" = "y" ] || [ "$DO_VLAN" = "Y" ]; then
        read -r -p "Enter parent interface for VLAN (e.g. eth0): " VLAN_PARENT
        if [ -n "$VLAN_PARENT" ] && [ -d "/sys/class/net/$VLAN_PARENT" ]; then
            read -r -p "Enter 802.1Q VLAN Tag (1-4094): " VLAN_ID
            if [[ "$VLAN_ID" =~ ^[0-9]+$ ]] && [ "$VLAN_ID" -ge 1 ] && [ "$VLAN_ID" -le 4094 ]; then
                VLAN_DEV="${VLAN_PARENT}.${VLAN_ID}"
                run_root ip link add link "$VLAN_PARENT" name "$VLAN_DEV" type vlan id "$VLAN_ID" 2>/dev/null || true
                run_root ip link set dev "$VLAN_DEV" up 2>/dev/null || true
                echo -e "${GREEN}[OK] Created VLAN interface: ${VLAN_DEV}${NC}\n"
                get_interfaces_table
            else
                echo -e "${RED}Invalid VLAN tag. Skipping VLAN creation.${NC}"
            fi
        else
            echo -e "${RED}Parent interface not found. Skipping VLAN creation.${NC}"
        fi
    fi

    # Auto-detection list of physical ports
    available_nics=($(ls -1 /sys/class/net 2>/dev/null | grep -E -v '^(lo|virbr|docker|veth|wg|tun|br)'))

    NEW_WAN=""
    NEW_LAN=""
    NEW_OPT1=""
    NEW_OPT2=""
    BRIDGE_SLAVES=()
    IS_BRIDGE_LAN=0

    # Step 2: Check for Standard Multi-Port Router Topology
    # First physical NIC is WAN; remaining physical ports bundled into switch bridge br0
    if [ "${#available_nics[@]}" -ge 2 ]; then
        echo -e "${CYAN}--- Standard Multi-Port Router Configuration Detected ---${NC}"
        echo -e "Physical Interfaces Found: ${BOLD}${available_nics[*]}${NC}"
        echo -e "  • First Physical NIC (WAN):  ${BOLD}${available_nics[0]}${NC}"
        remaining=("${available_nics[@]:1}")
        echo -e "  • Switch Ports (LAN Bridge): ${BOLD}br0${NC} containing [${remaining[*]}]"
        echo ""
        read -r -p "Apply standard router setup (WAN=${available_nics[0]}, LAN=br0 Switch) [Y/n]? " STD_ROUTER_CHOICE
        if [ "$STD_ROUTER_CHOICE" != "n" ] && [ "$STD_ROUTER_CHOICE" != "N" ]; then
            IS_BRIDGE_LAN=1
            NEW_WAN="${available_nics[0]}"
            NEW_LAN="br0"
            BRIDGE_SLAVES=("${remaining[@]}")
        fi
    fi

    if [ "$IS_BRIDGE_LAN" -eq 0 ]; then
        # Step 2b: Manual WAN Assignment
        echo ""
        echo "Enter the WAN interface name or 'a' for auto-detection:"
        read -r -p "(or press Enter to keep '${WAN_IF}'): " NEW_WAN
        if [ "$NEW_WAN" = "a" ] || [ "$NEW_WAN" = "A" ]; then
            NEW_WAN="${available_nics[0]:-eth0}"
            echo "Auto-detected WAN: $NEW_WAN"
        else
            NEW_WAN=${NEW_WAN:-$WAN_IF}
        fi

        # Step 3: Manual LAN Assignment
        echo ""
        remaining_after_wan=()
        for cand in "${available_nics[@]}"; do
            [ "$cand" != "$NEW_WAN" ] && remaining_after_wan+=("$cand")
        done

        if [ "${#remaining_after_wan[@]}" -ge 2 ]; then
            echo "Multiple physical interfaces remain: [${remaining_after_wan[*]}]"
            read -r -p "Bundle all remaining interfaces into a switch bridge (br0) for LAN [Y/n]? " BUNDLE_REMAINING
            if [ "$BUNDLE_REMAINING" != "n" ] && [ "$BUNDLE_REMAINING" != "N" ]; then
                IS_BRIDGE_LAN=1
                NEW_LAN="br0"
                BRIDGE_SLAVES=("${remaining_after_wan[@]}")
            fi
        fi

        if [ "$IS_BRIDGE_LAN" -eq 0 ]; then
            echo "Enter the LAN interface name or 'a' for auto-detection:"
            read -r -p "(or press Enter to keep '${LAN_IF}', or type 'none'): " NEW_LAN
            if [ "$NEW_LAN" = "a" ] || [ "$NEW_LAN" = "A" ]; then
                for cand in "${available_nics[@]}"; do
                    if [ "$cand" != "$NEW_WAN" ]; then
                        NEW_LAN="$cand"
                        break
                    fi
                done
                [ -n "$NEW_LAN" ] || NEW_LAN="$NEW_WAN"
                echo "Auto-detected LAN: $NEW_LAN"
            else
                NEW_LAN=${NEW_LAN:-$LAN_IF}
            fi

            # Check if user explicitly typed br0
            if [ "$NEW_LAN" = "br0" ]; then
                IS_BRIDGE_LAN=1
                read -r -p "Enter member switch ports for br0 (e.g. eth1 eth2): " SLAVES_IN
                BRIDGE_SLAVES=($SLAVES_IN)
            fi
        fi

        # Step 4: Optional OPT Interfaces
        if [ "$IS_BRIDGE_LAN" -eq 0 ]; then
            echo ""
            read -r -p "Enter the Optional 1 (OPT1) interface name (or press Enter if none): " NEW_OPT1
            NEW_OPT2=""
            if [ -n "$NEW_OPT1" ] && [ "$NEW_OPT1" != "none" ]; then
                read -r -p "Enter the Optional 2 (OPT2) interface name (or press Enter if none): " NEW_OPT2
            fi
        fi
    fi

    # Step 5: Summary & Confirmation
    echo -e "\n${BOLD}The interfaces will be assigned as follows:${NC}"
    echo "  WAN  -> ${NEW_WAN} (DHCP)"
    if [ "$IS_BRIDGE_LAN" -eq 1 ]; then
        echo "  LAN  -> ${NEW_LAN} (10.10.10.10/24) [Layer 2 Switch Bridge]"
        echo "          Member Switch Ports: [${BRIDGE_SLAVES[*]}]"
        echo "          Spanning Tree (STP): Enabled (IEEE 802.1D)"
    else
        echo "  LAN  -> ${NEW_LAN:-none} (10.10.10.10/24)"
    fi
    [ -n "$NEW_OPT1" ] && [ "$NEW_OPT1" != "none" ] && echo "  OPT1 -> ${NEW_OPT1}"
    [ -n "$NEW_OPT2" ] && [ "$NEW_OPT2" != "none" ] && echo "  OPT2 -> ${NEW_OPT2}"
    echo ""
    read -r -p "Do you want to proceed [Y/n]? " CONFIRM_ASSIGN
    if [ "$CONFIRM_ASSIGN" = "n" ] || [ "$CONFIRM_ASSIGN" = "N" ]; then
        echo "Interface assignment aborted."
        pause
        return
    fi

    echo -e "\n${YELLOW}Applying interface assignment...${NC}"

    # Build bridge slaves JSON array
    local slaves_json="[]"
    if [ "$IS_BRIDGE_LAN" -eq 1 ] && [ "${#BRIDGE_SLAVES[@]}" -gt 0 ]; then
        slaves_json=$(printf '["%s"]' "$(IFS='","'; echo "${BRIDGE_SLAVES[*]}")")
    fi

    # Write /etc/micron/network_init.json
    run_root mkdir -p /etc/micron
    run_root bash -c "cat << EOF > /etc/micron/network_init.json
{
  \"wan_interface\": \"$NEW_WAN\",
  \"lan_interface\": \"$NEW_LAN\",
  \"lan_is_bridge\": $([ "$IS_BRIDGE_LAN" -eq 1 ] && echo "true" || echo "false"),
  \"bridge_slaves\": $slaves_json,
  \"opt1_interface\": \"$NEW_OPT1\",
  \"opt2_interface\": \"$NEW_OPT2\",
  \"configured\": true
}
EOF"

    # Write /etc/network/interfaces
    run_root bash -c "cat << EOF > /etc/network/interfaces
# Micron OS Network Interface Configuration
auto lo
iface lo inet loopback

allow-hotplug $NEW_WAN
iface $NEW_WAN inet dhcp
EOF"

    if [ -n "$NEW_LAN" ] && [ "$NEW_LAN" != "none" ]; then
        if [ "$IS_BRIDGE_LAN" -eq 1 ]; then
            run_root bash -c "cat << EOF >> /etc/network/interfaces

auto $NEW_LAN
allow-hotplug $NEW_LAN
iface $NEW_LAN inet static
    address 10.10.10.10
    netmask 255.255.255.0
    bridge_ports ${BRIDGE_SLAVES[*]}
    bridge_stp on
    bridge_fd 2
EOF"
            for slave in "${BRIDGE_SLAVES[@]}"; do
                run_root bash -c "cat << EOF >> /etc/network/interfaces

allow-hotplug $slave
iface $slave inet manual
EOF"
            done
        else
            run_root bash -c "cat << EOF >> /etc/network/interfaces

auto $NEW_LAN
allow-hotplug $NEW_LAN
iface $NEW_LAN inet static
    address 10.10.10.10
    netmask 255.255.255.0
EOF"
        fi
    fi

    if [ -n "$NEW_OPT1" ] && [ "$NEW_OPT1" != "none" ]; then
        run_root bash -c "cat << EOF >> /etc/network/interfaces

allow-hotplug $NEW_OPT1
iface $NEW_OPT1 inet manual
EOF"
    fi

    if [ -n "$NEW_OPT2" ] && [ "$NEW_OPT2" != "none" ]; then
        run_root bash -c "cat << EOF >> /etc/network/interfaces

allow-hotplug $NEW_OPT2
iface $NEW_OPT2 inet manual
EOF"
    fi

    # Update SQLite database if present
    for dbpath in /usr/local/micron/writable/micron_config.db "$app_root/writable/micron_config.db"; do
        if [ -f "$dbpath" ] && command -v sqlite3 >/dev/null 2>&1; then
            run_root sqlite3 "$dbpath" "UPDATE interfaces SET physical_device='$NEW_WAN' WHERE id='wan';" 2>/dev/null || true
            if [ -n "$NEW_LAN" ] && [ "$NEW_LAN" != "none" ]; then
                run_root sqlite3 "$dbpath" "UPDATE interfaces SET physical_device='$NEW_LAN' WHERE id='lan';" 2>/dev/null || true
            fi
            if [ "$IS_BRIDGE_LAN" -eq 1 ]; then
                run_root sqlite3 "$dbpath" "INSERT OR REPLACE INTO interface_bridges (id, name, slaves, stp, forward_delay, mtu, description, created_at, updated_at) VALUES ('$NEW_LAN', 'LAN Switch Bridge', '$slaves_json', 1, 2, 1500, 'Standard Router Multi-Port LAN Bridge', datetime('now'), datetime('now'));" 2>/dev/null || true
            fi
        fi
    done

    # Bring interfaces up and configure runtime kernel networking
    run_root ip link set dev "$NEW_WAN" up 2>/dev/null || true

    if [ "$IS_BRIDGE_LAN" -eq 1 ]; then
        # Create kernel bridge
        run_root ip link add name "$NEW_LAN" type bridge 2>/dev/null || true
        run_root ip link set dev "$NEW_LAN" type bridge stp_state 1 forward_delay 200 2>/dev/null || true
        run_root ip link set dev "$NEW_LAN" mtu 1500 2>/dev/null || true
        
        # Enslave physical member ports and flush any IP from slaves
        for slave in "${BRIDGE_SLAVES[@]}"; do
            run_root ip addr flush dev "$slave" 2>/dev/null || true
            run_root ip link set dev "$slave" master "$NEW_LAN" 2>/dev/null || true
            run_root ip link set dev "$slave" up 2>/dev/null || true
        done
        run_root ip link set dev "$NEW_LAN" up 2>/dev/null || true
        run_root ip addr replace 10.10.10.10/24 dev "$NEW_LAN" 2>/dev/null || true
    elif [ -n "$NEW_LAN" ] && [ "$NEW_LAN" != "none" ]; then
        run_root ip link set dev "$NEW_LAN" up 2>/dev/null || true
        if [ "$NEW_LAN" != "$NEW_WAN" ]; then
            LL_ADDR=$(ip -4 addr show dev "$NEW_LAN" 2>/dev/null | awk '/inet 169\.254/ {print $2}' | head -n1 || true)
            [ -n "$LL_ADDR" ] && run_root ip addr del "$LL_ADDR" dev "$NEW_LAN" 2>/dev/null || true
            run_root ip addr replace 10.10.10.10/24 dev "$NEW_LAN" 2>/dev/null || true
        fi
    fi

    # Trigger DHCP on WAN asynchronously so menu does not stall
    run_root dhclient -r "$NEW_WAN" 2>/dev/null || true
    run_root dhclient -nw "$NEW_WAN" 2>/dev/null || true

    # Refresh banner
    if [ -x /usr/local/bin/micron-banner ]; then
        run_root /usr/local/bin/micron-banner || true
    fi

    ensure_numlock
    echo -e "${GREEN}[OK] Interface assignment applied successfully!${NC}"
    echo -e "WAN -> ${NEW_WAN} (DHCP requested)"
    if [ "$IS_BRIDGE_LAN" -eq 1 ]; then
        echo -e "LAN -> ${NEW_LAN} (10.10.10.10/24) [Switch Bridge over ${BRIDGE_SLAVES[*]}]"
    elif [ -n "$NEW_LAN" ] && [ "$NEW_LAN" != "none" ]; then
        echo -e "LAN -> ${NEW_LAN} (10.10.10.10/24)"
    fi
    pause
}

# ------------------------------------------------------------------------------
# Option 18: Layer 2 Bridge Interface (br0 Switch) CRUD Manager
# ------------------------------------------------------------------------------
manage_bridges_menu() {
    while true; do
        clear 2>/dev/null || true
        echo -e "${CYAN}"
        echo "================================================================================"
        echo "              Micron OS - Layer 2 Bridge & Switch Port Manager"
        echo "================================================================================"
        echo -e "${NC}"

        # Discover current bridges from kernel
        local bridges=()
        for br in /sys/class/net/*; do
            [ -d "$br/bridge" ] || continue
            bridges+=("$(basename "$br")")
        done

        echo -e "${BOLD}Current Active Bridge Interfaces:${NC}"
        if [ "${#bridges[@]}" -eq 0 ]; then
            echo -e "  ${YELLOW}(No active bridges configured in system)${NC}\n"
        else
            printf "  %-10s %-12s %-8s %s\n" "Bridge" "STP Status" "MTU" "Member Switch Ports"
            echo "  ----------------------------------------------------------------------------"
            for br in "${bridges[@]}"; do
                local stp="OFF"
                [ -f "/sys/class/net/$br/bridge/stp_state" ] && [ "$(cat "/sys/class/net/$br/bridge/stp_state" 2>/dev/null)" = "1" ] && stp="ON (802.1D)"
                local mtu="1500"
                [ -f "/sys/class/net/$br/mtu" ] && mtu=$(cat "/sys/class/net/$br/mtu" 2>/dev/null)
                local slaves=()
                for sl in /sys/class/net/$br/brif/*; do
                    [ -d "$sl" ] || continue
                    slaves+=("$(basename "$sl")")
                done
                local slave_str="${slaves[*]}"
                [ -n "$slave_str" ] || slave_str="none"
                printf "  %-10s %-12s %-8s [%s]\n" "$br" "$stp" "$mtu" "$slave_str"
            done
            echo ""
        fi

        echo "Actions:"
        echo "  1) List Bridge Interfaces & Connected Ports"
        echo "  2) Create New Bridge (or Setup Standard Router Switch br0)"
        echo "  3) Add Port(s) to Existing Bridge"
        echo "  4) Remove Port from Bridge"
        echo "  5) Delete Bridge Interface"
        echo "  r) Return to Main Menu"
        echo ""
        # A closed stdin must leave the submenu, not spin on an invalid choice.
        if ! read -r -p "Enter action [1-5, r]: " BR_ACT; then
            echo ""
            return 0
        fi

        case "$BR_ACT" in
            1)
                echo -e "\n${BOLD}--- Kernel Bridge & Port Details ---${NC}"
                if command -v bridge >/dev/null 2>&1; then
                    run_root bridge link show
                else
                    run_root ip -br link show type bridge
                fi
                echo ""
                read -r -p "Press Enter to continue..."
                ;;

            2)
                echo -e "\n${BOLD}--- Create / Configure Bridge Interface ---${NC}"
                read -r -p "Bridge name [br0]: " NEW_BR
                NEW_BR=${NEW_BR:-br0}

                # Show available physical interfaces
                echo "Available physical interfaces:"
                local avail=($(ls -1 /sys/class/net 2>/dev/null | grep -E -v '^(lo|virbr|docker|veth|wg|tun|br)'))
                echo "  ${avail[*]}"
                echo ""
                read -r -p "Enter member ports separated by spaces (e.g. eth1 eth2 eth3): " PORTS_IN
                if [ -z "$PORTS_IN" ]; then
                    echo -e "${RED}Error: At least one port required to create bridge.${NC}"
                    sleep 1
                    continue
                fi

                read -r -p "Enable Spanning Tree Protocol (STP) [Y/n]? " BR_STP
                local stp_val=1
                [ "$BR_STP" = "n" ] || [ "$BR_STP" = "N" ] && stp_val=0

                echo -e "${YELLOW}Creating bridge ${NEW_BR}...${NC}"
                run_root ip link add name "$NEW_BR" type bridge 2>/dev/null || true
                run_root ip link set dev "$NEW_BR" type bridge stp_state "$stp_val" forward_delay 200 2>/dev/null || true
                run_root ip link set dev "$NEW_BR" mtu 1500 2>/dev/null || true
                run_root ip link set dev "$NEW_BR" up 2>/dev/null || true

                local added_slaves=()
                for p in $PORTS_IN; do
                    if [ -d "/sys/class/net/$p" ]; then
                        run_root ip addr flush dev "$p" 2>/dev/null || true
                        run_root ip link set dev "$p" master "$NEW_BR" 2>/dev/null || true
                        run_root ip link set dev "$p" up 2>/dev/null || true
                        added_slaves+=("$p")
                        echo "  [+] Port $p enslaved to $NEW_BR"
                    else
                        echo "  [!] Interface $p not found, skipping"
                    fi
                done

                # Persist to database if exists
                for dbpath in /usr/local/micron/writable/micron_config.db "$app_root/writable/micron_config.db"; do
                    if [ -f "$dbpath" ] && command -v sqlite3 >/dev/null 2>&1; then
                        local sl_json
                        sl_json=$(printf '["%s"]' "$(IFS='","'; echo "${added_slaves[*]}")")
                        run_root sqlite3 "$dbpath" "INSERT OR REPLACE INTO interface_bridges (id, name, slaves, stp, forward_delay, mtu, description, created_at, updated_at) VALUES ('$NEW_BR', '${NEW_BR^^} Bridge', '$sl_json', $stp_val, 2, 1500, 'Configured via CLI menu', datetime('now'), datetime('now'));" 2>/dev/null || true
                        run_root sqlite3 "$dbpath" "INSERT OR REPLACE INTO interfaces (id, name, physical_device, type, ip_assignment_type, enabled, created_at, updated_at) VALUES ('$NEW_BR', '${NEW_BR^^} Switch', '$NEW_BR', 'physical', 'none', 1, datetime('now'), datetime('now'));" 2>/dev/null || true
                    fi
                done

                echo -e "${GREEN}[OK] Bridge ${NEW_BR} created successfully!${NC}"
                read -r -p "Press Enter to continue..."
                ;;

            3)
                echo -e "\n${BOLD}--- Add Port to Bridge ---${NC}"
                read -r -p "Bridge name [br0]: " TARGET_BR
                TARGET_BR=${TARGET_BR:-br0}
                if [ ! -d "/sys/class/net/$TARGET_BR/bridge" ]; then
                    echo -e "${RED}Error: Bridge $TARGET_BR does not exist.${NC}"
                    sleep 1
                    continue
                fi

                read -r -p "Interface to attach (e.g. eth3): " ADD_PORT
                if [ -n "$ADD_PORT" ] && [ -d "/sys/class/net/$ADD_PORT" ]; then
                    run_root ip addr flush dev "$ADD_PORT" 2>/dev/null || true
                    run_root ip link set dev "$ADD_PORT" master "$TARGET_BR" 2>/dev/null || true
                    run_root ip link set dev "$ADD_PORT" up 2>/dev/null || true
                    echo -e "${GREEN}[OK] Interface $ADD_PORT attached to $TARGET_BR.${NC}"

                    # Update database slaves list
                    local current_slaves=()
                    for sl in /sys/class/net/$TARGET_BR/brif/*; do
                        [ -d "$sl" ] || continue
                        current_slaves+=("$(basename "$sl")")
                    done
                    local sl_json
                    sl_json=$(printf '["%s"]' "$(IFS='","'; echo "${current_slaves[*]}")")
                    for dbpath in /usr/local/micron/writable/micron_config.db "$app_root/writable/micron_config.db"; do
                        if [ -f "$dbpath" ] && command -v sqlite3 >/dev/null 2>&1; then
                            run_root sqlite3 "$dbpath" "UPDATE interface_bridges SET slaves='$sl_json', updated_at=datetime('now') WHERE id='$TARGET_BR';" 2>/dev/null || true
                        fi
                    done
                else
                    echo -e "${RED}Error: Interface $ADD_PORT not found.${NC}"
                fi
                read -r -p "Press Enter to continue..."
                ;;

            4)
                echo -e "\n${BOLD}--- Remove Port from Bridge ---${NC}"
                read -r -p "Interface to detach from bridge (e.g. eth3): " REM_PORT
                if [ -n "$REM_PORT" ] && [ -d "/sys/class/net/$REM_PORT" ]; then
                    local parent_br
                    parent_br=$(cat "/sys/class/net/$REM_PORT/master/uevent" 2>/dev/null | grep 'INTERFACE=' | cut -d= -f2 || echo "")
                    run_root ip link set dev "$REM_PORT" nomaster 2>/dev/null || true
                    echo -e "${GREEN}[OK] Interface $REM_PORT released from bridge.${NC}"

                    if [ -n "$parent_br" ] && [ -d "/sys/class/net/$parent_br/bridge" ]; then
                        local current_slaves=()
                        for sl in /sys/class/net/$parent_br/brif/*; do
                            [ -d "$sl" ] || continue
                            current_slaves+=("$(basename "$sl")")
                        done
                        local sl_json
                        sl_json=$(printf '["%s"]' "$(IFS='","'; echo "${current_slaves[*]}")")
                        for dbpath in /usr/local/micron/writable/micron_config.db "$app_root/writable/micron_config.db"; do
                            if [ -f "$dbpath" ] && command -v sqlite3 >/dev/null 2>&1; then
                                run_root sqlite3 "$dbpath" "UPDATE interface_bridges SET slaves='$sl_json', updated_at=datetime('now') WHERE id='$parent_br';" 2>/dev/null || true
                            fi
                        done
                    fi
                else
                    echo -e "${RED}Error: Interface $REM_PORT not found.${NC}"
                fi
                read -r -p "Press Enter to continue..."
                ;;

            5)
                echo -e "\n${BOLD}--- Delete Bridge Interface ---${NC}"
                read -r -p "Bridge name to delete: " DEL_BR
                if [ -n "$DEL_BR" ] && [ -d "/sys/class/net/$DEL_BR/bridge" ]; then
                    read -r -p "Are you sure you want to delete bridge $DEL_BR [y/N]? " CONF_DEL
                    if [ "$CONF_DEL" = "y" ] || [ "$CONF_DEL" = "Y" ]; then
                        # Detach slaves first
                        for sl in /sys/class/net/$DEL_BR/brif/*; do
                            [ -d "$sl" ] || continue
                            local s_name
                            s_name=$(basename "$sl")
                            run_root ip link set dev "$s_name" nomaster 2>/dev/null || true
                        done
                        run_root ip link set dev "$DEL_BR" down 2>/dev/null || true
                        run_root ip link del dev "$DEL_BR" 2>/dev/null || true

                        # Remove from DB
                        for dbpath in /usr/local/micron/writable/micron_config.db "$app_root/writable/micron_config.db"; do
                            if [ -f "$dbpath" ] && command -v sqlite3 >/dev/null 2>&1; then
                                run_root sqlite3 "$dbpath" "DELETE FROM interface_bridges WHERE id='$DEL_BR';" 2>/dev/null || true
                                run_root sqlite3 "$dbpath" "DELETE FROM interfaces WHERE id='$DEL_BR';" 2>/dev/null || true
                            fi
                        done

                        echo -e "${GREEN}[OK] Bridge $DEL_BR deleted and ports released.${NC}"
                    else
                        echo "Deletion cancelled."
                    fi
                else
                    echo -e "${RED}Error: Bridge $DEL_BR not found.${NC}"
                fi
                read -r -p "Press Enter to continue..."
                ;;

            r|R|q|Q)
                return 0
                ;;

            *)
                echo -e "${RED}Invalid choice.${NC}"
                sleep 1
                ;;
        esac
    done
}
# ------------------------------------------------------------------------------
# Option 19: Enable / Disable DHCP Server Menu
# ------------------------------------------------------------------------------
manage_dhcp_menu() {
    while true; do
        ensure_numlock
        clear 2>/dev/null || true
        echo -e "${CYAN}══════════════════════════════════════════════════════════════════════${NC}"
        echo -e "${BOLD}${GREEN}  MICRON OS — DHCP SERVICE MANAGEMENT (Kea DHCPv4)${NC}"
        echo -e "${CYAN}══════════════════════════════════════════════════════════════════════${NC}\n"

        # 1. Determine active database path
        local db_found=""
        for p in /usr/local/micron/writable/micron_config.db "$app_root/writable/micron_config.db"; do
            if [ -f "$p" ]; then
                db_found="$p"
                break
            fi
        done

        # 2. Query DHCP enabled status from database
        local db_enabled="0"
        local pool_from=""
        local pool_to=""
        if [ -n "$db_found" ] && command -v sqlite3 >/dev/null 2>&1; then
            db_enabled=$(sqlite3 "$db_found" "SELECT enabled FROM dhcp_server_settings WHERE interface_id='lan' LIMIT 1;" 2>/dev/null || echo "0")
            pool_from=$(sqlite3 "$db_found" "SELECT range_from FROM dhcp_server_settings WHERE interface_id='lan' LIMIT 1;" 2>/dev/null || echo "")
            pool_to=$(sqlite3 "$db_found" "SELECT range_to FROM dhcp_server_settings WHERE interface_id='lan' LIMIT 1;" 2>/dev/null || echo "")
        fi

        # 3. Check live system service status
        local svc_active="inactive"
        if run_root systemctl is-active --quiet kea-dhcp4-server 2>/dev/null; then
            svc_active="active"
        fi

        # 4. Display status
        if [ "$db_enabled" = "1" ] && [ "$svc_active" = "active" ]; then
            echo -e "Current DHCP Status : ${BOLD}${GREEN}ENABLED${NC} (Service Active & Running)"
        elif [ "$db_enabled" = "1" ]; then
            echo -e "Current DHCP Status : ${BOLD}${YELLOW}ENABLED${NC} (Configured in DB; Service Stopped/Starting)"
        else
            echo -e "Current DHCP Status : ${BOLD}${RED}DISABLED${NC} (Service Inactive)"
        fi

        # 5. Determine current LAN device & subnet
        get_network_info
        local lan_dev="${LAN_IF:-eth1}"
        local lan_cidr="${LAN_IP:-10.10.10.10/24}"
        local lan_base=$(echo "$lan_cidr" | cut -d/ -f1)
        local lan_prefix=$(echo "$lan_cidr" | cut -d/ -f2)
        lan_prefix=${lan_prefix:-24}
        local lan_3oct=$(echo "$lan_base" | cut -d. -f1-3)

        [ -n "$pool_from" ] || pool_from="${lan_3oct}.100"
        [ -n "$pool_to" ] || pool_to="${lan_3oct}.200"

        echo -e "Bound Interface     : ${BOLD}${lan_dev}${NC} (LAN)"
        echo -e "LAN IP / Subnet     : ${BOLD}${lan_cidr}${NC}"
        echo -e "Configured Range    : ${BOLD}${pool_from} - ${pool_to}${NC}\n"

        echo " 1) Enable DHCP"
        echo " 2) Disable DHCP"
        echo " 3) Return to Main Menu"
        echo ""
        # A closed stdin must leave the submenu rather than default-loop.
        if ! read -r -p "Enter choice [3]: " DHCP_CHOICE; then
            echo ""
            return 0
        fi
        DHCP_CHOICE=${DHCP_CHOICE:-3}

        case "$DHCP_CHOICE" in
            1)
                echo -e "\n${BOLD}${YELLOW}Enabling DHCP Service for LAN (${lan_dev})...${NC}"

                # Update SQLite database
                for dbpath in /usr/local/micron/writable/micron_config.db "$app_root/writable/micron_config.db"; do
                    if [ -f "$dbpath" ] && command -v sqlite3 >/dev/null 2>&1; then
                        local has_row
                        has_row=$(sqlite3 "$dbpath" "SELECT COUNT(*) FROM dhcp_server_settings WHERE interface_id='lan';" 2>/dev/null || echo "0")
                        if [ "$has_row" -gt 0 ]; then
                            run_root sqlite3 "$dbpath" "UPDATE dhcp_server_settings SET enabled=1, range_from='${pool_from}', range_to='${pool_to}', gateway='${lan_base}', dns_1='${lan_base}', updated_at=datetime('now') WHERE interface_id='lan';" 2>/dev/null || true
                        else
                            run_root sqlite3 "$dbpath" "INSERT INTO dhcp_server_settings (interface_id, enabled, range_from, range_to, gateway, dns_1) VALUES ('lan', 1, '${pool_from}', '${pool_to}', '${lan_base}', '${lan_base}');" 2>/dev/null || true
                        fi
                    fi
                done

                # Configure Kea DHCP configuration file
                run_root mkdir -p /etc/kea /var/lib/kea
                run_root bash -c "cat << 'EOF' > /etc/kea/kea-dhcp4.conf
{
  \"Dhcp4\": {
    \"interfaces-config\": {
      \"interfaces\": [ \"${lan_dev}\" ]
    },
    \"lease-database\": {
      \"type\": \"memfile\",
      \"persist\": true,
      \"name\": \"/var/lib/kea/kea-leases4.csv\"
    },
    \"valid-lifetime\": 7200,
    \"max-valid-lifetime\": 86400,
    \"subnet4\": [
      {
        \"id\": 1,
        \"subnet\": \"${lan_3oct}.0/${lan_prefix}\",
        \"interface\": \"${lan_dev}\",
        \"pools\": [
          { \"pool\": \"${pool_from} - ${pool_to}\" }
        ],
        \"option-data\": [
          {
            \"name\": \"routers\",
            \"data\": \"${lan_base}\"
          },
          {
            \"name\": \"domain-name-servers\",
            \"data\": \"${lan_base}, 1.1.1.1, 8.8.8.8\"
          }
        ]
      }
    ]
  }
}
EOF"

                # Start and enable kea-dhcp4-server
                run_root systemctl enable kea-dhcp4-server 2>/dev/null || true
                local restart_ok=0
                if run_root systemctl restart kea-dhcp4-server 2>/dev/null; then
                    restart_ok=1
                elif run_root service kea-dhcp4-server restart 2>/dev/null; then
                    restart_ok=1
                fi

                if [ "$restart_ok" -eq 1 ] || run_root systemctl is-active --quiet kea-dhcp4-server 2>/dev/null; then
                    echo -e "${GREEN}[OK] DHCP Service successfully ENABLED and started.${NC}"
                    echo -e "${GREEN}[OK] LAN clients on ${lan_dev} will receive IP leases in range ${pool_from} - ${pool_to}.${NC}"
                    echo -e "${GREEN}[OK] Configuration saved: DHCP will start automatically on reboot.${NC}"
                else
                    echo -e "${GREEN}[OK] DHCP Service configured and ENABLED in database.${NC}"
                    echo -e "${GREEN}[OK] Configuration saved: DHCP service enabled for ${lan_dev}.${NC}"
                fi
                read -r -p "Press Enter to continue..."
                ;;

            2)
                echo -e "\n${BOLD}${YELLOW}Disabling DHCP Service...${NC}"

                # Update SQLite database to disabled
                for dbpath in /usr/local/micron/writable/micron_config.db "$app_root/writable/micron_config.db"; do
                    if [ -f "$dbpath" ] && command -v sqlite3 >/dev/null 2>&1; then
                        run_root sqlite3 "$dbpath" "UPDATE dhcp_server_settings SET enabled=0, updated_at=datetime('now') WHERE interface_id='lan';" 2>/dev/null || true
                    fi
                done

                # Stop and disable systemd service
                run_root systemctl stop kea-dhcp4-server 2>/dev/null || true
                run_root systemctl disable kea-dhcp4-server 2>/dev/null || true

                echo -e "${GREEN}[OK] DHCP Service successfully DISABLED and stopped.${NC}"
                echo -e "${GREEN}[OK] No dynamic IP addresses will be assigned to LAN clients.${NC}"
                echo -e "${GREEN}[OK] Configuration saved: DHCP will remain disabled on system reboot.${NC}"
                read -r -p "Press Enter to continue..."
                ;;

            3|q|Q|r|R)
                return 0
                ;;

            *)
                echo -e "${RED}Invalid choice '${DHCP_CHOICE}'. Please choose 1, 2, or 3.${NC}"
                sleep 1
                ;;
        esac
    done
}

# ------------------------------------------------------------------------------
# Main Interactive Loop
# ------------------------------------------------------------------------------
# Return to the menu on interrupt instead of tearing down the console session.
trap 'menu_on_interrupt' INT TERM

while true; do
    print_header
    # EOF (^D) or a closed stdin means the operator's session is gone (an SSH
    # channel that dropped, a pipe that closed). Leave cleanly — never reboot,
    # and never spin: re-reading a closed stdin would busy-loop forever.
    if ! read -r -p "Enter an option: " OPTION; then
        echo ""
        echo "Input closed — leaving the Micron OS console menu."
        exit 0
    fi

    case "$OPTION" in
        0)
            echo "Logging out..."
            ensure_numlock
            exit 0
            ;;

        1)
            assign_interfaces_pfsense
            ;;

        2)
            echo -e "\n${BOLD}=== 2) Set Interface IP Address ===${NC}"
            read -r -p "Configure (1) LAN or (2) WAN? [1]: " IF_CHOICE
            IF_CHOICE=${IF_CHOICE:-1}

            if [ "$IF_CHOICE" = "1" ]; then
                read -r -p "Configure LAN as (D)HCP or (S)tatic? [S]: " LAN_TYPE
                LAN_TYPE=${LAN_TYPE:-S}

                if [ "$LAN_TYPE" = "D" ] || [ "$LAN_TYPE" = "d" ]; then
                    for dbpath in /usr/local/micron/writable/micron_config.db "$app_root/writable/micron_config.db"; do
                        if [ -f "$dbpath" ] && command -v sqlite3 >/dev/null 2>&1; then
                            run_root sqlite3 "$dbpath" "UPDATE interfaces SET physical_device='$LAN_IF', ip_assignment_type='dhcp' WHERE id='lan';" 2>/dev/null || true
                            run_root sqlite3 "$dbpath" "UPDATE dhcp_server_settings SET enabled=0, updated_at=datetime('now') WHERE interface_id='lan';" 2>/dev/null || true
                        fi
                    done

                    # Stop and disable Kea DHCP server to prevent rogue DHCP leases on local subnet
                    run_root systemctl stop kea-dhcp4-server 2>/dev/null || true
                    run_root systemctl disable kea-dhcp4-server 2>/dev/null || true

                    # Flush current static IP and trigger DHCP client on LAN interface
                    run_root ip addr flush dev "$LAN_IF" 2>/dev/null || true
                    run_root ip link set dev "$LAN_IF" up 2>/dev/null || true
                    run_root dhclient -r "$LAN_IF" 2>/dev/null || true
                    run_root dhclient -4 -nw -pf "/run/dhclient.${LAN_IF}.pid" "$LAN_IF" 2>/dev/null || true

                    if [ -x /usr/local/bin/micron-network ]; then
                        run_root /usr/local/bin/micron-network || true
                    fi

                    echo -e "${GREEN}[OK] DHCP requested on ${LAN_IF} (LAN).${NC}"
                    echo -e "${YELLOW}[i] Local DHCP server (Kea) automatically stopped on ${LAN_IF} to prevent network conflicts.${NC}"
                else
                    read -r -p "Enter new LAN IPv4 address with CIDR mask [10.10.10.10/24]: " NEW_LAN_CIDR
                    NEW_LAN_CIDR=${NEW_LAN_CIDR:-10.10.10.10/24}

                    LAN_ONLY_IP=$(echo "$NEW_LAN_CIDR" | cut -d/ -f1)
                    LAN_MASK=$(echo "$NEW_LAN_CIDR" | cut -d/ -f2)
                    LAN_MASK=${LAN_MASK:-24}

                    if [ -x /usr/local/bin/microctl ]; then
                        run_root /usr/local/bin/microctl interface set-lan "$NEW_LAN_CIDR" || true
                    fi

                    # Update SQLite database with current active interfaces
                    for dbpath in /usr/local/micron/writable/micron_config.db "$app_root/writable/micron_config.db"; do
                        if [ -f "$dbpath" ] && command -v sqlite3 >/dev/null 2>&1; then
                            run_root sqlite3 "$dbpath" "UPDATE interfaces SET physical_device='$LAN_IF', ip_assignment_type='static', ipv4_address='$LAN_ONLY_IP', ipv4_netmask=$LAN_MASK WHERE id='lan';" 2>/dev/null || true
                            run_root sqlite3 "$dbpath" "UPDATE interfaces SET physical_device='$WAN_IF' WHERE id='wan';" 2>/dev/null || true
                        fi
                    done

                    # Enable kernel packet forwarding
                    run_root sysctl -w net.ipv4.ip_forward=1 net.ipv4.conf.all.forwarding=1 net.ipv6.conf.all.forwarding=1 >/dev/null 2>&1 || true

                    # Apply IP to interface immediately
                    run_root ip addr flush dev "$LAN_IF" 2>/dev/null || true
                    run_root ip addr add "$NEW_LAN_CIDR" dev "$LAN_IF" 2>/dev/null || true
                    run_root ip link set dev "$LAN_IF" up 2>/dev/null || true

                    # Synchronize daemon, DHCP server, DNS resolver and nftables
                    if [ -x /usr/local/bin/micron-network ]; then
                        run_root /usr/local/bin/micron-network || true
                    fi

                    # Check for WAN/LAN subnet overlap
                    if [ -n "$WAN_IP" ] && [[ "$WAN_IP" =~ ^[0-9]+\.[0-9]+\.[0-9]+ ]]; then
                        wan_sub=$(echo "$WAN_IP" | cut -d. -f1-3)
                        lan_sub=$(echo "$LAN_ONLY_IP" | cut -d. -f1-3)
                        if [ "$wan_sub" = "$lan_sub" ] && [ "$WAN_IF" != "$LAN_IF" ]; then
                            echo -e "\n${RED}[!] ATTENTION: WAN subnet ($wan_sub.0/24) and LAN subnet ($lan_sub.0/24) overlap!${NC}"
                            echo -e "${YELLOW}To avoid routing conflicts, ensure WAN and LAN are on separate subnets.${NC}"
                        fi
                    fi

                    echo -e "${GREEN}[OK] LAN interface configured to $NEW_LAN_CIDR${NC}"
                    echo -e "${GREEN}[OK] Plug-and-play DHCP server and DNS active on $LAN_IF.${NC}"
                fi
            else
                read -r -p "Configure WAN as (D)HCP or (S)tatic? [D]: " WAN_TYPE
                WAN_TYPE=${WAN_TYPE:-D}
                if [ "$WAN_TYPE" = "S" ] || [ "$WAN_TYPE" = "s" ]; then
                    read -r -p "Enter static WAN IPv4/mask (e.g. 192.168.5.100/24): " STATIC_WAN
                    read -r -p "Enter Default Gateway IPv4: " GW_WAN
                    WAN_ONLY_IP=$(echo "$STATIC_WAN" | cut -d/ -f1)
                    WAN_MASK=$(echo "$STATIC_WAN" | cut -d/ -f2)
                    WAN_MASK=${WAN_MASK:-24}

                    for dbpath in /usr/local/micron/writable/micron_config.db "$app_root/writable/micron_config.db"; do
                        if [ -f "$dbpath" ] && command -v sqlite3 >/dev/null 2>&1; then
                            run_root sqlite3 "$dbpath" "UPDATE interfaces SET physical_device='$WAN_IF', ip_assignment_type='static', ipv4_address='$WAN_ONLY_IP', ipv4_netmask=$WAN_MASK, ipv4_gateway='$GW_WAN' WHERE id='wan';" 2>/dev/null || true
                        fi
                    done

                    run_root ip addr flush dev "$WAN_IF" 2>/dev/null || true
                    run_root ip addr add "$STATIC_WAN" dev "$WAN_IF" 2>/dev/null || true
                    run_root ip link set dev "$WAN_IF" up 2>/dev/null || true
                    [ -z "$GW_WAN" ] || run_root ip route replace default via "$GW_WAN" dev "$WAN_IF" 2>/dev/null || true
                    echo -e "${GREEN}[OK] WAN configured statically.${NC}"
                else
                    for dbpath in /usr/local/micron/writable/micron_config.db "$app_root/writable/micron_config.db"; do
                        if [ -f "$dbpath" ] && command -v sqlite3 >/dev/null 2>&1; then
                            run_root sqlite3 "$dbpath" "UPDATE interfaces SET physical_device='$WAN_IF', ip_assignment_type='dhcp' WHERE id='wan';" 2>/dev/null || true
                        fi
                    done

                    run_root dhclient -r "$WAN_IF" 2>/dev/null || true
                    run_root dhclient -4 -nw -pf "/run/dhclient.${WAN_IF}.pid" "$WAN_IF" 2>/dev/null || true
                    echo -e "${GREEN}[OK] DHCP requested on $WAN_IF.${NC}"
                fi

                if [ -x /usr/local/bin/micron-network ]; then
                    run_root /usr/local/bin/micron-network || true
                fi
            fi

            if [ -x /usr/local/bin/micron-banner ]; then
                run_root /usr/local/bin/micron-banner || true
            fi
            ensure_numlock
            pause
            ;;

        3)
            echo -e "\n${BOLD}=== 3) Reset Web GUI Password ===${NC}"
            read -r -p "Enter new password for Ministrator [M1Cr0N]: " NEW_PW || true
            NEW_PW=${NEW_PW:-M1Cr0N}
            if [ -x /usr/local/bin/microctl ]; then
                if ! run_root /usr/local/bin/microctl admin reset-password "$NEW_PW"; then
                    echo -e "${RED}[ERROR] microctl could not reset the application password.${NC}"
                    echo -e "${YELLOW}The OS account password was still updated below.${NC}"
                fi
            else
                echo -e "${YELLOW}microctl not found; executing direct password reset...${NC}"
            fi
            echo "ministrator:${NEW_PW}" | run_root chpasswd 2>/dev/null || true
            echo -e "${GREEN}[OK] Ministrator OS account password updated.${NC}"
            echo -e "${GREEN}[OK] Two-factor authentication (TOTP) reset for administrative access.${NC}"
            pause
            ;;

        4)
            echo -e "\n${BOLD}=== 4) Reset to Factory Defaults ===${NC}"
            read -r -p "Are you sure you want to restore factory default configuration? [Y/n]: " CONFIRM_RESET
            CONFIRM_RESET=${CONFIRM_RESET:-Y}
            if [[ "$CONFIRM_RESET" =~ ^[yY] ]]; then
                echo -e "${YELLOW}Restoring initial database seed...${NC}"
                if [ -d "$app_root" ] && command -v php >/dev/null 2>&1; then
                    cd "$app_root"
                    run_root php spark db:seed InitialApplianceSeeder || true
                    run_root php spark db:seed RolesPermissionsSeeder || true
                fi
                if [ -x /usr/local/bin/microctl ]; then
                    run_root /usr/local/bin/microctl firewall reset || true
                fi
                echo -e "${GREEN}[OK] Appliance successfully reset to factory defaults.${NC}"
            else
                echo "Factory reset cancelled."
            fi
            pause
            ;;

        5)
            echo -e "\n${BOLD}=== 5) Reboot System ===${NC}"
            read -r -p "Reboot Micron OS appliance now? (y/N): " CONFIRM_RB
            if [ "$CONFIRM_RB" = "y" ] || [ "$CONFIRM_RB" = "Y" ]; then
                menu_reboot
                exit 0
            fi
            echo "Reboot cancelled."
            ;;

        6)
            echo -e "\n${BOLD}=== 6) Halt System (Power Off) ===${NC}"
            read -r -p "Power off Micron OS appliance now? (y/N): " CONFIRM_HL
            if [ "$CONFIRM_HL" = "y" ] || [ "$CONFIRM_HL" = "Y" ]; then
                menu_poweroff
                exit 0
            fi
            echo "Power off cancelled."
            ;;

        7)
            echo -e "\n${BOLD}=== 7) Ping Host ===${NC}"
            read -r -p "Enter host or IP address to ping [1.1.1.1]: " PING_TARGET
            PING_TARGET=${PING_TARGET:-1.1.1.1}
            echo ""
            ping -c 4 "$PING_TARGET" || true
            pause
            ;;

        8)
            echo -e "\n${BOLD}=== 8) Shell (Root Bash Prompt) ===${NC}"
            echo -e "${GREEN}Dropping to root bash prompt.${NC}"
            echo "Type 'exit' to return to Micron OS console menu."
            echo ""
            run_root touch /tmp/.micron_in_shell 2>/dev/null || true
            run_root chmod 666 /tmp/.micron_in_shell 2>/dev/null || true
            export MICRON_SHELL=1
            export IN_MICRON_MENU=1
            ROOT_PS1='\[\033[01;31m\][MicronOS] \w # \[\033[00m\]'

            ensure_numlock

            RC_SCRIPT="${app_root}/system/micron-shell-rc"
            if [ ! -f "$RC_SCRIPT" ]; then
                RC_SCRIPT="/tmp/micron-shell-rc"
                cat << 'EOF' > "$RC_SCRIPT"
[ -f /etc/bash.bashrc ] && . /etc/bash.bashrc 2>/dev/null
[ -f /root/.bashrc ] && . /root/.bashrc 2>/dev/null
[ -f ~/.bashrc ] && . ~/.bashrc 2>/dev/null
export MICRON_SHELL=1
export IN_MICRON_MENU=1
export PS1='\[\033[01;31m\][MicronOS] \w # \[\033[00m\]'
if command -v setleds >/dev/null 2>&1; then
    setleds -D +num 2>/dev/null || true
fi
EOF
            fi

            if [ "$EUID" -eq 0 ]; then
                /bin/bash --rcfile "$RC_SCRIPT" -i || /bin/bash -i
            else
                sudo -E env MICRON_SHELL=1 IN_MICRON_MENU=1 /bin/bash --rcfile "$RC_SCRIPT" -i || sudo /bin/bash -i
            fi

            run_root rm -f /tmp/.micron_in_shell 2>/dev/null || true
            unset MICRON_SHELL
            ensure_numlock
            echo ""
            pause
            ;;

        9)
            echo -e "\n${BOLD}=== 9) System Monitor ===${NC}"
            if command -v htop >/dev/null 2>&1; then
                htop || true
            else
                top || true
            fi
            ensure_numlock
            ;;

        10)
            echo -e "\n${BOLD}=== 10) Filter & System Logs ===${NC}"
            echo "1) Active Packet Filter (nftables ruleset summary)"
            echo "2) Daemon Logs (micrond)"
            echo "3) Web Management Plane Log"
            echo "4) System Journal (last 40 events)"
            read -r -p "Select log source [1]: " LOG_OPT
            LOG_OPT=${LOG_OPT:-1}
            case "$LOG_OPT" in
                1)
                    run_root nft list ruleset 2>/dev/null | head -n 40 || echo "nftables not loaded."
                    ;;
                2)
                    run_root journalctl -u micrond -n 30 --no-pager 2>/dev/null || echo "No micrond logs."
                    ;;
                3)
                    tail -n 30 "$app_root"/writable/logs/log-*.log 2>/dev/null || echo "No web logs."
                    ;;
                4)
                    run_root journalctl -n 40 --no-pager 2>/dev/null || true
                    ;;
            esac
            pause
            ;;

        11)
            echo -e "\n${BOLD}=== 11) Restart Web GUI ===${NC}"
            echo "Restarting Apache2 web server..."
            run_root systemctl restart apache2 || true
            run_root systemctl status apache2 --no-pager -l 2>/dev/null | head -n 10 || true
            echo -e "${GREEN}[OK] Web GUI service restarted.${NC}"
            pause
            ;;

        12)
            echo -e "\n${BOLD}=== 12) PHP Shell / App Console ===${NC}"
            if [ -d "$app_root" ] && [ -f "$app_root/spark" ]; then
                run_root php "$app_root/spark" list || true
            else
                echo -e "${RED}App console not located.${NC}"
            fi
            pause
            ;;

        13)
            echo -e "\n${BOLD}=== 13) Update & Firmware Manager ===${NC}"
            echo "Current A/B Boot Slot Configuration:"
            if [ -x /usr/local/bin/micron-slot-rescue ]; then
                run_root /usr/local/bin/micron-slot-rescue status || true
            elif [ -x /usr/local/micron/installer/micron-slot-rescue ]; then
                run_root /usr/local/micron/installer/micron-slot-rescue status || true
            elif [ -x /usr/local/micron/installer/micron-slot ]; then
                run_root /usr/local/micron/installer/micron-slot show || true
            fi
            echo ""
            echo "  1) Make Slot A the Permanent Boot Target"
            echo "  2) Make Slot B the Permanent Boot Target"
            echo "  3) Launch Emergency Slot Rescue & Healing Wizard (Option 17)"
            echo "  4) Return to Main Menu"
            read -r -p "Enter selection [1-4]: " SLOT_ACT
            case "$SLOT_ACT" in
                1)
                    if [ -x /usr/local/bin/micron-slot-rescue ]; then
                        run_root /usr/local/bin/micron-slot-rescue a || true
                    elif [ -x /usr/local/micron/installer/micron-slot-rescue ]; then
                        run_root /usr/local/micron/installer/micron-slot-rescue a || true
                    elif [ -x /usr/local/micron/installer/micron-slot ]; then
                        run_root /usr/local/micron/installer/micron-slot activate a || true
                    fi
                    echo -e "${GREEN}[OK] Slot A is configured as the permanent primary boot target.${NC}"
                    ;;
                2)
                    if [ -x /usr/local/bin/micron-slot-rescue ]; then
                        run_root /usr/local/bin/micron-slot-rescue b || true
                    elif [ -x /usr/local/micron/installer/micron-slot-rescue ]; then
                        run_root /usr/local/micron/installer/micron-slot-rescue b || true
                    elif [ -x /usr/local/micron/installer/micron-slot ]; then
                        run_root /usr/local/micron/installer/micron-slot activate b || true
                    fi
                    echo -e "${GREEN}[OK] Slot B is configured as the permanent primary boot target.${NC}"
                    ;;
                3)
                    if [ -x /usr/local/bin/micron-slot-rescue ]; then
                        run_root /usr/local/bin/micron-slot-rescue || true
                    elif [ -x /usr/local/micron/installer/micron-slot-rescue ]; then
                        run_root /usr/local/micron/installer/micron-slot-rescue || true
                    fi
                    ;;
                *)
                    ;;
            esac
            ensure_numlock
            pause
            ;;

        14)
            echo -e "\n${BOLD}=== 14) Toggle SSH Service ===${NC}"
            if run_root systemctl is-active --quiet ssh; then
                echo "SSH is currently running. Stopping and disabling SSH..."
                run_root systemctl stop ssh || true
                run_root systemctl disable ssh || true
                echo -e "${YELLOW}[OK] SSH service disabled.${NC}"
            else
                echo "SSH is stopped. Enabling and starting SSH..."
                run_root systemctl enable ssh || true
                run_root systemctl start ssh || true
                echo -e "${GREEN}[OK] SSH service enabled on port 22.${NC}"
            fi
            pause
            ;;

        15)
            echo -e "\n${BOLD}=== 15) Restore Configuration Backup ===${NC}"
            read -r -p "Enter path to configuration backup file (.mbk): " BK_PATH || true
            if [ -f "$BK_PATH" ] && [ -x /usr/local/bin/microctl ]; then
                if run_root /usr/local/bin/microctl backup restore "$BK_PATH"; then
                    echo -e "${GREEN}[OK] Configuration restore completed.${NC}"
                else
                    echo -e "${RED}[ERROR] Configuration restore FAILED. No changes were rebooted; review the output above.${NC}"
                fi
            else
                echo -e "${RED}Backup file not found at $BK_PATH${NC}"
            fi
            pause
            ;;

        16)
            echo -e "\n${BOLD}=== 16) Restart micrond & PHP-FPM ===${NC}"
            echo "Restarting micrond IPC daemon and PHP-FPM..."
            run_root systemctl restart micrond || true
            run_root systemctl restart php8.4-fpm 2>/dev/null || run_root systemctl restart php-fpm 2>/dev/null || true
            echo -e "${GREEN}[OK] Data-plane IPC daemon and PHP runtime restarted.${NC}"
            pause
            ;;

        17)
            echo -e "\n${BOLD}=== 17) A/B Boot Slot Rescue & Switch ===${NC}"
            if [ -x /usr/local/bin/micron-slot-rescue ]; then
                run_root /usr/local/bin/micron-slot-rescue || true
            elif [ -x /usr/local/micron/installer/micron-slot-rescue ]; then
                run_root /usr/local/micron/installer/micron-slot-rescue || true
            elif [ -x "$app_root/installer/micron-slot-rescue" ]; then
                run_root "$app_root/installer/micron-slot-rescue" || true
            else
                echo -e "${RED}micron-slot-rescue utility not found.${NC}"
            fi
            ensure_numlock
            pause
            ;;

        18)
            manage_bridges_menu || true
            ;;

        19)
            manage_dhcp_menu || true
            ;;

        "")
            # Enter pressed with no input -> refresh status immediately
            continue
            ;;

        *)
            echo -e "${RED}Invalid option '${OPTION}'. Please enter a number 0 to 19.${NC}"
            sleep 1
            ;;
    esac

    # A handler must never be able to end the menu (and, on tty1, the session).
    # Every option falls through to here and back to print_header().
done
