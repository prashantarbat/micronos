#!/bin/bash
# ==============================================================================
# MicronOS Debian 13 (Trixie) Live-Build Auto-Configuration Script
# ==============================================================================
set -e

# ------------------------------------------------------------------------------
# Stage the appliance overlay before the configuration is snapshotted.
# ------------------------------------------------------------------------------
# live-build copies config/includes.chroot/ onto the image, so this is what puts
# the Terminal CLI (and its shell completion) into the appliance. Staging it from
# bin/microctl on every build keeps one source of truth instead of a second copy
# that drifts. A failure here aborts the build rather than producing an image
# with no console CLI.
src_dir="${MICRONOS_SRC:-${here}/../..}"
if [ ! -f "${src_dir}/bin/microctl" ] && [ -f "/mnt/d/laragon/www/micronos/micronos/bin/microctl" ]; then
    src_dir="/mnt/d/laragon/www/micronos/micronos"
fi
if [ -f "${here}/stage-overlay.sh" ]; then
    bash "${here}/stage-overlay.sh" --src "${src_dir}"
fi

lb config noauto \
    --distribution trixie \
    --architectures amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --linux-flavours amd64 \
    --binary-images iso-hybrid \
    --bootloaders "grub-efi syslinux" \
    --iso-application "Micron OS" \
    --iso-preparer "Micron OS Engineering Team" \
    --iso-publisher "Micron OS Security Appliance" \
    --iso-volume "MICRON_OS_AMD64" \
    --memtest none \
    --win32-loader false \
    --security true \
    --updates true \
    --apt-indices true \
    --apt-recommends false \
    --bootappend-live "boot=live components quiet username=ministrator user-fullname=Ministrator hostname=micron-os" \
    --checksums sha256 \
    "${@}"
