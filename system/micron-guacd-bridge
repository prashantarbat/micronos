#!/usr/bin/env python3
"""
micron-guacd-bridge — WebSocket tunnel between the browser and guacd.

guacd speaks the Guacamole protocol over plain TCP; browsers can only open
WebSockets. This service sits between the two for the ZTNA Clientless
Gateway's in-browser RDP / SSH / VNC / telnet viewer. Python standard library
only (it ships on the ISO and must work offline).

Trust model
-----------
* The listener binds 127.0.0.1 only. Apache (management UI) and nginx (ZTNA
  gateway) proxy /vpn/clientless-gateway/tunnel to it.
* The browser presents the connection token the Web UI minted in
  ZtnaGateway::launch(). The token is `b64url(json).hex(hmac_sha256(json))`,
  signed with the key in /etc/micron/ztna-tunnel.key. This service creates
  that key (0640 root:www-data) when it is missing, and PHP signs with it.
* The target host, port and protocol come only from the signed token; the
  browser chooses nothing but the display size. The guacd handshake is done
  here, so the browser can never send its own `select`/`connect`.

Protocol
--------
WebSocket subprotocol "guacamole", as spoken by guacamole-common-js'
Guacamole.WebSocketTunnel: every text message carries whole Guacamole
instructions. The first message to the browser is the internal ("") opcode
carrying the tunnel UUID. Internal `ping` instructions are answered here and
never reach guacd.
"""
from __future__ import annotations

import argparse
import asyncio
import base64
import codecs
import grp
import hashlib
import hmac
import json
import logging
import os
import secrets
import struct
import sys
import time
import uuid
from typing import Dict, List, Optional, Tuple
from urllib.parse import parse_qs, urlsplit

VERSION = "1.0.0"
CONFIG_PATH = os.environ.get("MICRON_GUACD_BRIDGE_CONFIG", "/etc/micron/guacd-bridge.json")

DEFAULTS: Dict[str, object] = {
    "listen_host": "127.0.0.1",
    "listen_port": 4823,
    "key_path": "/etc/micron/ztna-tunnel.key",
    "key_group": "www-data",
    "revoked_path": "/run/micron/ztna-revoked.json",
    "revocation_poll": 3,
    "max_sessions": 32,
    "max_frame": 1048576,
    "handshake_timeout": 15,
}

WS_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
PROTOCOLS = ("rdp", "ssh", "vnc", "telnet")
CLIENT_PROTOCOL_VERSION = "VERSION_1_5_0"

# Guacamole status codes sent to the browser in `error` instructions.
STATUS_UPSTREAM_ERROR = "515"
STATUS_UPSTREAM_NOT_FOUND = "519"
STATUS_CLIENT_UNAUTHORIZED = "769"

# Connection parameters that make each protocol usable from a browser with no
# per-resource tuning. Anything guacd asks for that is not here is sent empty,
# which means "guacd default". Missing credentials are requested from the user
# through the `required` instruction once the connection is up.
PROTOCOL_DEFAULTS: Dict[str, Dict[str, str]] = {
    "rdp": {
        "security": "any",
        "ignore-cert": "true",
        "resize-method": "display-update",
    },
    "ssh": {},
    "vnc": {},
    "telnet": {},
}

log = logging.getLogger("micron-guacd-bridge")


def load_config(path: str = CONFIG_PATH) -> Dict[str, object]:
    cfg = dict(DEFAULTS)
    try:
        with open(path, "r", encoding="utf-8") as fh:
            data = json.load(fh)
        if isinstance(data, dict):
            cfg.update({k: v for k, v in data.items() if k in DEFAULTS})
    except FileNotFoundError:
        pass
    except (OSError, ValueError) as exc:
        log.warning("ignoring unreadable config %s: %s", path, exc)
    return cfg


def ensure_key(path: str, group: str) -> None:
    """Create the token signing key if it does not exist yet (run as root)."""
    if os.path.exists(path):
        return
    os.makedirs(os.path.dirname(path), mode=0o755, exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o640)
    try:
        os.write(fd, (secrets.token_hex(32) + "\n").encode())
    finally:
        os.close(fd)
    try:
        os.chown(tmp, 0, grp.getgrnam(group).gr_gid)
    except (KeyError, PermissionError):
        pass
    os.chmod(tmp, 0o640)
    os.replace(tmp, path)
    log.info("created tunnel signing key %s", path)


def read_key(path: str) -> Optional[bytes]:
    try:
        with open(path, "r", encoding="utf-8") as fh:
            key = fh.read().strip()
    except OSError:
        return None
    return key.encode() if key else None


def verify_token(token: str, key: bytes) -> Optional[Dict[str, object]]:
    """Return the token payload, or None when it is malformed, forged or expired."""
    if not token or "." not in token or len(token) > 8192:
        return None
    body, sig = token.rsplit(".", 1)
    try:
        raw = base64.urlsafe_b64decode(body + "=" * (-len(body) % 4))
    except (ValueError, TypeError):
        return None
    expected = hmac.new(key, raw, hashlib.sha256).hexdigest()
    if not hmac.compare_digest(expected, sig):
        return None
    try:
        payload = json.loads(raw)
    except ValueError:
        return None
    if not isinstance(payload, dict):
        return None
    if not isinstance(payload.get("expires"), int) or payload["expires"] < time.time():
        return None
    if payload.get("type") not in PROTOCOLS:
        return None
    if not isinstance(payload.get("host"), str) or not payload["host"]:
        return None
    for field in ("port", "guacd_port"):
        if not isinstance(payload.get(field), int) or not 0 < payload[field] < 65536:
            return None
    if not isinstance(payload.get("guacd_host"), str) or not payload["guacd_host"]:
        return None
    return payload


def token_signature(token: str) -> str:
    return token.rsplit(".", 1)[-1]


def is_revoked(path: str, signature: str) -> bool:
    """True when micrond's `ztna.session_kill` has revoked this token."""
    try:
        with open(path, "r", encoding="utf-8") as fh:
            revoked = json.load(fh)
    except (OSError, ValueError):
        return False
    return isinstance(revoked, dict) and signature in revoked


# ------------------------------------------------------------- Guacamole wire

def encode(*elements: str) -> str:
    return ",".join(f"{len(e)}.{e}" for e in elements) + ";"


def split_complete(buf: str) -> Tuple[str, str]:
    """Split buf into (whole instructions, trailing partial instruction).

    Element lengths are counted in Unicode code points, as the protocol
    defines them, which is what len() on a str counts.
    """
    end = 0
    pos = 0
    n = len(buf)
    while pos < n:
        i = pos
        while True:
            dot = buf.find(".", i, i + 12)
            if dot == -1:
                if n - i >= 12:
                    raise ValueError("malformed instruction length")
                return buf[:end], buf[end:]
            digits = buf[i:dot]
            if not digits.isdigit():
                raise ValueError("malformed instruction length")
            j = dot + 1 + int(digits)
            if j >= n:
                return buf[:end], buf[end:]
            term = buf[j]
            if term == ",":
                i = j + 1
                continue
            if term == ";":
                pos = end = j + 1
                break
            raise ValueError("malformed instruction terminator")
    return buf[:end], buf[end:]


def parse_instruction(text: str) -> List[str]:
    """Elements of one whole instruction (opcode first)."""
    elements: List[str] = []
    i = 0
    while True:
        dot = text.index(".", i)
        length = int(text[i:dot])
        start = dot + 1
        elements.append(text[start:start + length])
        term = text[start + length]
        i = start + length + 1
        if term == ";":
            return elements


def first_instruction(text: str) -> str:
    """The first whole instruction at the start of a run of whole instructions."""
    i = 0
    while True:
        dot = text.index(".", i)
        j = dot + 1 + int(text[i:dot])
        if text[j] == ";":
            return text[:j + 1]
        i = j + 1


class GuacdStream:
    """Instruction-aligned reader over the guacd TCP connection."""

    def __init__(self, reader: asyncio.StreamReader, writer: asyncio.StreamWriter):
        self.reader = reader
        self.writer = writer
        self.decoder = codecs.getincrementaldecoder("utf-8")()
        self.buf = ""

    async def read_chunk(self) -> Optional[str]:
        """Next run of whole instructions; None at EOF."""
        while True:
            complete, self.buf = split_complete(self.buf)
            if complete:
                return complete
            data = await self.reader.read(65536)
            if not data:
                return None
            self.buf += self.decoder.decode(data)

    async def read_instruction(self) -> Optional[List[str]]:
        """One whole instruction (used during the handshake only)."""
        while True:
            try:
                head, _ = split_complete(self.buf)
            except ValueError:
                return None
            if head:
                first = first_instruction(head)
                self.buf = self.buf[len(first):]
                return parse_instruction(first)
            data = await self.reader.read(65536)
            if not data:
                return None
            self.buf += self.decoder.decode(data)

    async def send(self, text: str) -> None:
        self.writer.write(text.encode("utf-8"))
        await self.writer.drain()

    def close(self) -> None:
        try:
            self.writer.close()
        except Exception:  # noqa: BLE001
            pass


# ------------------------------------------------------------- WebSocket

class WebSocket:
    """Minimal RFC 6455 server endpoint (no extensions, server never masks)."""

    def __init__(self, reader: asyncio.StreamReader, writer: asyncio.StreamWriter, max_frame: int):
        self.reader = reader
        self.writer = writer
        self.max_frame = max_frame
        self.closed = False

    async def _send(self, opcode: int, payload: bytes) -> None:
        if self.closed:
            return
        n = len(payload)
        if n < 126:
            head = struct.pack("!BB", 0x80 | opcode, n)
        elif n < 65536:
            head = struct.pack("!BBH", 0x80 | opcode, 126, n)
        else:
            head = struct.pack("!BBQ", 0x80 | opcode, 127, n)
        try:
            self.writer.write(head + payload)
            await self.writer.drain()
        except (ConnectionError, RuntimeError):
            self.closed = True

    async def send_text(self, text: str) -> None:
        await self._send(0x1, text.encode("utf-8"))

    async def close(self, code: int = 1000, reason: str = "") -> None:
        if self.closed:
            return
        await self._send(0x8, struct.pack("!H", code) + reason.encode("utf-8")[:120])
        self.closed = True
        try:
            self.writer.close()
        except Exception:  # noqa: BLE001
            pass

    async def recv(self) -> Optional[Tuple[int, bytes]]:
        """Next complete data message (opcode, payload); None when closed."""
        message = bytearray()
        msg_op = None
        while True:
            try:
                b1, b2 = await self.reader.readexactly(2)
            except (asyncio.IncompleteReadError, ConnectionError):
                return None
            fin, opcode, masked, length = b1 & 0x80, b1 & 0x0F, b2 & 0x80, b2 & 0x7F
            if b1 & 0x70 or not masked:
                await self.close(1002, "protocol error")
                return None
            try:
                if length == 126:
                    length = struct.unpack("!H", await self.reader.readexactly(2))[0]
                elif length == 127:
                    length = struct.unpack("!Q", await self.reader.readexactly(8))[0]
                if length > self.max_frame or len(message) + length > self.max_frame:
                    await self.close(1009, "message too big")
                    return None
                mask = await self.reader.readexactly(4)
                data = bytearray(await self.reader.readexactly(length))
            except (asyncio.IncompleteReadError, ConnectionError):
                return None
            for i in range(length):
                data[i] ^= mask[i & 3]
            if opcode == 0x8:
                await self.close(1000)
                return None
            if opcode == 0x9:
                await self._send(0xA, bytes(data[:125]))
                continue
            if opcode == 0xA:
                continue
            if opcode in (0x1, 0x2):
                if msg_op is not None:
                    await self.close(1002, "protocol error")
                    return None
                msg_op = opcode
            elif opcode == 0x0:
                if msg_op is None:
                    await self.close(1002, "protocol error")
                    return None
            else:
                await self.close(1002, "protocol error")
                return None
            message += data
            if fin:
                return msg_op, bytes(message)


# ------------------------------------------------------------- service

def clamp_int(value: Optional[str], low: int, high: int, default: int) -> int:
    try:
        n = int(value or "")
    except ValueError:
        return default
    return max(low, min(high, n))


class BridgeService:
    def __init__(self, cfg: Dict[str, object]):
        self.cfg = cfg
        self.active = 0

    async def handle_http(self, reader: asyncio.StreamReader, writer: asyncio.StreamWriter) -> None:
        peer = (writer.get_extra_info("peername") or ("?",))[0]
        try:
            head = await asyncio.wait_for(reader.readuntil(b"\r\n\r\n"), timeout=10)
        except (asyncio.TimeoutError, asyncio.IncompleteReadError, asyncio.LimitOverrunError, ConnectionError):
            writer.close()
            return
        lines = head.decode("latin-1").split("\r\n")
        try:
            method, target, _ = lines[0].split(" ", 2)
        except ValueError:
            return self._http_error(writer, 400, "bad request")
        headers: Dict[str, str] = {}
        for line in lines[1:]:
            if ":" in line:
                k, v = line.split(":", 1)
                headers[k.strip().lower()] = v.strip()
        url = urlsplit(target)
        if method != "GET" or url.path not in ("/tunnel", "/vpn/clientless-gateway/tunnel"):
            return self._http_error(writer, 404, "not found")
        if headers.get("upgrade", "").lower() != "websocket" or "sec-websocket-key" not in headers:
            return self._http_error(writer, 426, "websocket required")

        client = peer
        if peer in ("127.0.0.1", "::1") and headers.get("x-forwarded-for"):
            client = headers["x-forwarded-for"].split(",")[-1].strip()

        origin = headers.get("origin", "")
        host = headers.get("x-forwarded-host", headers.get("host", "")).split(",")[0].strip()
        if origin and urlsplit(origin).netloc != host:
            log.warning("refused tunnel from %s: origin %s does not match host %s", client, origin, host)
            return self._http_error(writer, 403, "origin not allowed")

        key = read_key(str(self.cfg["key_path"]))
        qs = parse_qs(url.query)
        token = (qs.get("token") or [""])[0]
        payload = verify_token(token, key) if key else None
        if payload is None:
            log.warning("refused tunnel from %s: missing, forged or expired token", client)
            return self._http_error(writer, 403, "invalid token")
        signature = token_signature(token)
        if is_revoked(str(self.cfg["revoked_path"]), signature):
            log.warning("refused tunnel from %s: session was terminated", client)
            return self._http_error(writer, 403, "session terminated")
        if self.active >= int(self.cfg["max_sessions"]):
            log.warning("refused tunnel from %s: session limit reached", client)
            return self._http_error(writer, 503, "too many sessions")

        accept = base64.b64encode(hashlib.sha1((headers["sec-websocket-key"] + WS_GUID).encode()).digest()).decode()
        response = ("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
                    f"Sec-WebSocket-Accept: {accept}\r\n")
        offered = [p.strip() for p in headers.get("sec-websocket-protocol", "").split(",")]
        if "guacamole" in offered:
            response += "Sec-WebSocket-Protocol: guacamole\r\n"
        writer.write((response + "\r\n").encode())

        ws = WebSocket(reader, writer, int(self.cfg["max_frame"]))
        display = {
            "width": clamp_int((qs.get("width") or [""])[0], 320, 7680, 1280),
            "height": clamp_int((qs.get("height") or [""])[0], 200, 4320, 720),
            "dpi": clamp_int((qs.get("dpi") or [""])[0], 48, 384, 96),
        }
        self.active += 1
        try:
            await self.run_session(ws, payload, display, client, signature)
        finally:
            self.active -= 1

    @staticmethod
    def _http_error(writer: asyncio.StreamWriter, code: int, text: str) -> None:
        body = text.encode()
        writer.write(f"HTTP/1.1 {code} {text}\r\nContent-Type: text/plain\r\nContent-Length: {len(body)}\r\n"
                     "Connection: close\r\n\r\n".encode() + body)
        writer.close()

    async def handshake(self, guacd: GuacdStream, payload: Dict[str, object], display: Dict[str, int]) -> str:
        """Run select → args → connect → ready. Returns the guacd connection id."""
        protocol = str(payload["type"])
        await guacd.send(encode("select", protocol))
        args = await guacd.read_instruction()
        if not args or args[0] != "args":
            raise ConnectionError(f"guacd refused protocol {protocol}: {args[1] if args and len(args) > 1 else 'no reply'}")

        params = dict(PROTOCOL_DEFAULTS.get(protocol, {}))
        params["hostname"] = str(payload["host"])
        params["port"] = str(payload["port"])
        values = []
        for name in args[1:]:
            values.append(CLIENT_PROTOCOL_VERSION if name.startswith("VERSION_") else params.get(name, ""))

        await guacd.send(
            encode("size", str(display["width"]), str(display["height"]), str(display["dpi"]))
            + encode("audio", "audio/L8", "audio/L16")
            + encode("video")
            + encode("image", "image/png", "image/jpeg", "image/webp")
            + encode("timezone", time.tzname[0] if time.tzname else "UTC")
            + encode("name", str(payload.get("username", "")))
            + encode("connect", *values)
        )
        ready = await guacd.read_instruction()
        if not ready or ready[0] != "ready":
            raise ConnectionError(f"guacd did not accept the connection: {ready[1] if ready and len(ready) > 1 else 'no reply'}")
        return ready[1] if len(ready) > 1 else ""

    async def run_session(self, ws: WebSocket, payload: Dict[str, object], display: Dict[str, int], client: str,
                          signature: str = "") -> None:
        user = payload.get("username", "?")
        target = f"{payload['type']}://{payload['host']}:{payload['port']}"
        tunnel_id = str(uuid.uuid4())
        await ws.send_text(encode("", tunnel_id))

        try:
            reader, writer = await asyncio.wait_for(
                asyncio.open_connection(str(payload["guacd_host"]), int(payload["guacd_port"])),
                timeout=float(self.cfg["handshake_timeout"]),
            )
        except (OSError, asyncio.TimeoutError) as exc:
            log.error("guacd %s:%s unreachable for %s (%s): %s",
                      payload["guacd_host"], payload["guacd_port"], user, target, exc)
            await ws.send_text(encode("error", "The remote desktop service (guacd) is not running.", STATUS_UPSTREAM_NOT_FOUND))
            await ws.close(1000)
            return

        guacd = GuacdStream(reader, writer)
        try:
            conn_id = await asyncio.wait_for(self.handshake(guacd, payload, display),
                                             timeout=float(self.cfg["handshake_timeout"]))
        except (ConnectionError, ValueError, asyncio.TimeoutError) as exc:
            log.error("guacd handshake failed for %s (%s): %s", user, target, exc)
            await ws.send_text(encode("error", f"Could not open {target}: {exc}", STATUS_UPSTREAM_ERROR))
            await ws.close(1000)
            guacd.close()
            return

        log.info("session %s opened: user=%s client=%s target=%s guacd=%s", tunnel_id, user, client, target, conn_id)
        started = time.time()

        async def upstream() -> None:
            while True:
                try:
                    chunk = await guacd.read_chunk()
                except ValueError as exc:
                    log.error("session %s: malformed data from guacd: %s", tunnel_id, exc)
                    return
                if chunk is None or ws.closed:
                    return
                await ws.send_text(chunk)

        async def downstream() -> None:
            while True:
                msg = await ws.recv()
                if msg is None:
                    return
                op, data = msg
                if op != 0x1:
                    continue
                try:
                    text = data.decode("utf-8")
                except UnicodeDecodeError:
                    continue
                if text.startswith("0.,"):
                    # Internal tunnel instruction: answer pings, never forward.
                    try:
                        elements = parse_instruction(text)
                    except (ValueError, IndexError):
                        continue
                    if len(elements) >= 2 and elements[1] == "ping":
                        await ws.send_text(text)
                    continue
                await guacd.send(text)

        async def watch_revocation() -> None:
            # An administrator's "terminate" revokes the token; drop the live tunnel.
            while True:
                await asyncio.sleep(float(self.cfg["revocation_poll"]))
                if signature and is_revoked(str(self.cfg["revoked_path"]), signature):
                    log.info("session %s terminated by an administrator", tunnel_id)
                    await ws.send_text(encode("error", "This session was terminated by an administrator.",
                                              STATUS_CLIENT_UNAUTHORIZED))
                    return

        tasks = [asyncio.ensure_future(upstream()), asyncio.ensure_future(downstream()),
                 asyncio.ensure_future(watch_revocation())]
        try:
            await asyncio.wait(tasks, return_when=asyncio.FIRST_COMPLETED)
        finally:
            for t in tasks:
                t.cancel()
            guacd.close()
            await ws.close(1000)
            log.info("session %s closed after %ds", tunnel_id, int(time.time() - started))


async def main_async(cfg: Dict[str, object]) -> None:
    service = BridgeService(cfg)
    server = await asyncio.start_server(service.handle_http, str(cfg["listen_host"]), int(cfg["listen_port"]))
    log.info("micron-guacd-bridge %s listening on %s:%s", VERSION, cfg["listen_host"], cfg["listen_port"])
    async with server:
        await server.serve_forever()


def main() -> int:
    parser = argparse.ArgumentParser(description="WebSocket tunnel between the browser and guacd")
    parser.add_argument("--ensure-key", action="store_true", help="create the token signing key if missing and exit")
    args = parser.parse_args()
    logging.basicConfig(level=logging.INFO, format="%(levelname)s %(message)s", stream=sys.stderr)
    cfg = load_config()
    if args.ensure_key:
        ensure_key(str(cfg["key_path"]), str(cfg["key_group"]))
        return 0
    try:
        asyncio.run(main_async(cfg))
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
