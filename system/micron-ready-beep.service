[Unit]
Description=Micron OS System Ready Audible Indicator (3 Long & Loud Beeps)
Documentation=https://github.com/micronos/micronos
# Fire after local filesystems, micrond, and health check confirm operational status.
# Note: network-online.target is intentionally omitted so beeps sound reliably
# even when the appliance boots offline or without an active WAN uplink.
After=local-fs.target micrond.service micron-healthcheck.service
Wants=micrond.service

[Service]
Type=oneshot
User=root
Group=root
ExecStartPre=-/sbin/modprobe pcspkr
ExecStartPre=-/sbin/modprobe snd_pcm
ExecStart=/usr/local/bin/micron-ready-beep
RemainAfterExit=true
StandardOutput=journal
StandardError=journal
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
