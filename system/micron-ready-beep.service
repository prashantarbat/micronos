[Unit]
Description=Micron OS System Ready Audible Indicator (3 Short Beeps)
Documentation=https://github.com/micronos/micronos
# Fire after the health check confirms the slot is good — this guarantees
# the beep is only heard when the appliance has fully and successfully booted.
# Changing from After=apache2 prevents the beep unit from being held back
# by an apache2 failure during the first-boot retry cycle.
After=network.target network-online.target micron-network.service micrond.service micron-healthcheck.service systemd-user-sessions.service
Wants=micron-network.service

[Service]
Type=oneshot
# Must run as root: KIOCSOUND ioctl on /dev/console requires CAP_SYS_TTY_CONFIG,
# and the 'beep' package requires write access to /dev/input event devices.
User=root
Group=root
# Explicitly load pcspkr before the script runs.
# Debian 13 Trixie blacklists pcspkr by default; the installer removes
# the blacklist entry, but modprobe here is a belt-and-braces fallback.
ExecStartPre=-/sbin/modprobe pcspkr
ExecStart=/usr/local/bin/micron-ready-beep
RemainAfterExit=true
StandardOutput=journal
StandardError=journal
TimeoutStartSec=15

[Install]
WantedBy=multi-user.target
