#!/bin/bash
# ==============================================================================
# Micron OS — Dynamic Console & Login Banner Generator
# ==============================================================================
# Generates /etc/issue, /etc/issue.net, and /etc/motd dynamically based on the
# appliance network interfaces, active IP addresses, and runtime slot status.
# ==============================================================================
set -euo pipefail

# 1-2. WAN / LAN roles as the operator assigned them (console option 1).
# The banner only reports: it never guesses a port and never adds an address.
DB_PATH="/usr/local/micron/writable/micron_config.db"
role_dev() { # <wan|lan>
    local d=""
    if [ -f "$DB_PATH" ] && command -v sqlite3 >/dev/null 2>&1; then
        d=$(sqlite3 "$DB_PATH" "SELECT physical_device FROM interfaces WHERE id='$1' AND enabled=1;" 2>/dev/null || true)
    fi
    if [ -z "$d" ] && [ -f /etc/micron/network_init.json ]; then
        d=$(grep -o "\"$1_interface\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" /etc/micron/network_init.json 2>/dev/null | cut -d'"' -f4 || true)
    fi
    printf '%s' "$d"
}
role_ip() { # <device>
    [ -n "$1" ] || return 0
    ip -4 addr show dev "$1" 2>/dev/null | awk '/inet / && !/169\.254/ {print $2}' | cut -d/ -f1 | head -n1 || true
}
role_desc() { # <device> <ip> <db-mode>
    if [ -z "$1" ]; then
        echo "not assigned (console option 1: Assign Interfaces)"
    elif [ ! -d "/sys/class/net/$1" ]; then
        echo "$1 (not present - reassign with console option 1)"
    elif [ -n "$2" ]; then
        echo "$1 ($2)"
    elif [ "$3" = "dhcp" ]; then
        echo "$1 (DHCP Client - Acquiring)"
    else
        echo "$1 (no IPv4 address)"
    fi
}

WAN_IF=$(role_dev wan)
LAN_IF=$(role_dev lan)
WAN_IP=""
for _ in 1 2 3; do
    WAN_IP=$(role_ip "$WAN_IF")
    [ -n "$WAN_IP" ] || [ -z "$WAN_IF" ] && break
    sleep 1
done
LAN_IP=$(role_ip "$LAN_IF")

DB_WAN_MODE="dhcp"; DB_LAN_MODE="static"
if [ -f "$DB_PATH" ] && command -v sqlite3 >/dev/null 2>&1; then
    DB_WAN_MODE=$(sqlite3 "$DB_PATH" "SELECT ip_assignment_type FROM interfaces WHERE id='wan' AND enabled=1;" 2>/dev/null || echo "dhcp")
    DB_LAN_MODE=$(sqlite3 "$DB_PATH" "SELECT ip_assignment_type FROM interfaces WHERE id='lan' AND enabled=1;" 2>/dev/null || echo "static")
fi
WAN_DESC=$(role_desc "$WAN_IF" "$WAN_IP" "$DB_WAN_MODE")
LAN_DESC=$(role_desc "$LAN_IF" "$LAN_IP" "$DB_LAN_MODE")

# 3. Determine Management Web IP
MGMT_IP=""
if [ -n "$LAN_IP" ]; then
    MGMT_IP="$LAN_IP"
elif [ -n "$WAN_IP" ]; then
    MGMT_IP="$WAN_IP"
fi
if [ -n "$MGMT_IP" ]; then
    MGMT_DESC="http://${MGMT_IP}/ (Port 80)"
else
    MGMT_DESC="unavailable until interfaces are assigned"
fi

# 4. Detect Active Slot
#
# Resolve by the filesystem LABEL of the mounted root, never by partition number.
# The A/B layout is 1=ESP 2=BIOS-boot 3=swap 4=MICRON_ROOT_A 5=MICRON_ROOT_B
# 6=MICRON_DATA, so a numbering guess is off by one: the old rule mapped p4 to
# Slot B and therefore announced "Slot B" on every fresh install, which actually
# boots MICRON_ROOT_A at p4. micron-slot's GRUB environment is the second
# authority and the device name is only a last resort.
ROOT_DEV=$(findmnt -n -o SOURCE / 2>/dev/null || true)
ROOT_LABEL=$(blkid -s LABEL -o value "$ROOT_DEV" 2>/dev/null || true)
ACTIVE_SLOT=""
case "$ROOT_LABEL" in
    MICRON_ROOT_A) ACTIVE_SLOT="A" ;;
    MICRON_ROOT_B) ACTIVE_SLOT="B" ;;
esac
if [ -z "$ACTIVE_SLOT" ]; then
    for slot_helper in /usr/local/bin/micron-slot /usr/local/micron/installer/micron-slot; do
        [ -x "$slot_helper" ] || continue
        s=$(MICRON_SLOT_ENV=/boot/grub/grubenv "$slot_helper" active 2>/dev/null || true)
        case "${s,,}" in
            a) ACTIVE_SLOT="A"; break ;;
            b) ACTIVE_SLOT="B"; break ;;
        esac
    done
fi
if [ -z "$ACTIVE_SLOT" ]; then
    case "$ROOT_DEV" in
        *MICRON_ROOT_B) ACTIVE_SLOT="B" ;;
        *)              ACTIVE_SLOT="A" ;;
    esac
fi
SLOT_INFO=" Active Root Slot : Slot ${ACTIVE_SLOT} (Active & Verified)"

# 5. Construct Banner
BANNER_FILE=$(mktemp /tmp/micron-banner.XXXXXX)
cat << 'EOF' > "$BANNER_FILE"

███╗   ███╗██╗ ██████╗██████╗  ██████╗ ███╗   ██╗     ██████╗ ███████╗
████╗ ████║██║██╔════╝██╔══██╗██╔═══██╗████╗  ██║    ██╔═══██╗██╔════╝
██╔████╔██║██║██║     ██████╔╝██║   ██║██╔██╗ ██║    ██║   ██║███████╗
██║╚██╔╝██║██║██║     ██╔══██╗██║   ██║██║╚██╗██║    ██║   ██║╚════██║
██║ ╚═╝ ██║██║╚██████╗██║  ██║╚██████╔╝██║ ╚████║    ╚██████╔╝███████║
╚═╝     ╚═╝╚═╝ ╚═════╝╚═╝  ╚═╝ ╚═════╝ ╚═╝  ╚═══╝     ╚═════╝ ╚══════╝
 Enterprise  Next-Gen Firewall & Network Appliance

 WAN Interface : @WAN_DESC@
 LAN Interface : @LAN_DESC@

 Management Web GUI : @MGMT_DESC@
EOF

# Substitute parameters
sed -i "s|@WAN_DESC@|${WAN_DESC}|g" "$BANNER_FILE"
sed -i "s|@LAN_DESC@|${LAN_DESC}|g" "$BANNER_FILE"
sed -i "s|@MGMT_DESC@|${MGMT_DESC}|g" "$BANNER_FILE"

if [ -n "$SLOT_INFO" ]; then
    echo "$SLOT_INFO" >> "$BANNER_FILE"
fi
echo "" >> "$BANNER_FILE"

# 6. Apply to /etc/issue, /etc/issue.net, /etc/motd
cp "$BANNER_FILE" /etc/issue
cp "$BANNER_FILE" /etc/issue.net
cp "$BANNER_FILE" /etc/motd

rm -f "$BANNER_FILE"
exit 0
