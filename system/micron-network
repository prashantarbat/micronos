#!/bin/bash
# ==============================================================================
# Micron OS — boot-time network bring-up
# ==============================================================================
# Makes the kernel match the committed network configuration on every boot,
# using the same pieces the Web UI and the CLI use at run time:
#
#   1. bind the configured WAN/LAN roles to NICs that actually exist (first
#      boot on new hardware: real names such as enp1s0 / eno1);
#   2. `php spark network boot-files` builds, from the configuration database,
#      the network plan, the nftables ruleset and the Kea DHCPv4 config — the
#      very same NetworkPlan / NftablesCompiler / KeaDhcpCompiler the Web UI
#      transaction uses (micrond is not running yet, so no RPC);
#   3. system/micron_netcfg.py applies the plan (addresses, default route,
#      IPv6 master switch, dhclient) — the engine micrond's network.apply uses;
#      if the database cannot produce a plan, the last committed plan
#      (/etc/micron/network.json) is applied instead;
#   4. the ruleset and the DHCP config are syntax-checked and loaded.
#
# Nothing here hard-codes an address or a DHCP pool any more: a reboot can no
# longer bring back an old LAN address, pool or firewall rule.
#
# IPv6 is OFF unless the administrator switched it on (System > Networking):
# /etc/sysctl.d/60-micron-ipv6.conf already disables it before this runs.
# ==============================================================================
set -uo pipefail

app_root="/usr/local/micron"
[ -d "$app_root" ] || app_root="$(cd "$(dirname "$0")/.." && pwd)"
DB_PATH="$app_root/writable/micron_config.db"
NETCFG="$app_root/system/micron_netcfg.py"
WORK="/run/micron/network-boot"
NFT_CONF="${MICRON_NFT_CONF:-/etc/nftables.conf}"
log() { echo "[micron-network] $*"; }

# IPv4 forwarding is always on (this is a router). IPv6 forwarding is set by
# the plan only when IPv6 is enabled.
sysctl -q -w net.ipv4.ip_forward=1 || true
sysctl -q -w net.ipv4.conf.all.forwarding=1 || true
sysctl -q -w net.ipv4.conf.default.forwarding=1 || true

# ---------------------------------------------------------------- 1. NICs
avail_nics=()
for ifpath in /sys/class/net/*; do
    [ -d "$ifpath" ] || continue
    dev=$(basename "$ifpath")
    [[ "$dev" =~ ^(lo|virbr|docker|veth|wg|tun|ifb|sit|ip6tnl|gre|ppp) ]] && continue
    [ -d "$ifpath/bridge" ] && continue
    [ -e "$ifpath/device" ] || continue          # physical ports only
    avail_nics+=("$dev")
done
if [ "${#avail_nics[@]}" -eq 0 ]; then
    log "warning: no physical network interfaces found"
fi

have_db=0
if [ -f "$DB_PATH" ] && command -v sqlite3 >/dev/null 2>&1; then
    have_db=1
fi
sqlq() { sqlite3 "$DB_PATH" "$1" 2>/dev/null || true; }
dev_ok() { [ -n "$1" ] && [ -d "/sys/class/net/$1" ]; }
safe_dev() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,14}$ ]]; }

WAN_IF=""; LAN_IF=""
if [ "$have_db" -eq 1 ]; then
    WAN_IF=$(sqlq "SELECT physical_device FROM interfaces WHERE id='wan' LIMIT 1;")
    LAN_IF=$(sqlq "SELECT physical_device FROM interfaces WHERE id='lan' LIMIT 1;")
fi
if [ "${#avail_nics[@]}" -eq 1 ]; then
    # One port only: it must be the management LAN, or nobody can reach the
    # appliance. A WAN configured on that same port cannot coexist with it
    # (the plan refuses one device for two interfaces), so it is disabled.
    dev_ok "$LAN_IF" || LAN_IF="${avail_nics[0]}"
    [ "$WAN_IF" = "$LAN_IF" ] && WAN_IF=""
    if [ "$have_db" -eq 1 ] && safe_dev "$LAN_IF"; then
        sqlq "UPDATE interfaces SET physical_device='$LAN_IF' WHERE id='lan';"
        sqlq "UPDATE interfaces SET enabled=0 WHERE id='wan' AND physical_device='$LAN_IF';"
    fi
elif [ "${#avail_nics[@]}" -gt 1 ]; then
    if ! dev_ok "$WAN_IF"; then
        WAN_IF=""
        for cand in "${avail_nics[@]}"; do
            [ "$cand" != "$LAN_IF" ] && { WAN_IF="$cand"; break; }
        done
    fi
    if ! dev_ok "$LAN_IF" || [ "$LAN_IF" = "$WAN_IF" ]; then
        LAN_IF=""
        for cand in "${avail_nics[@]}"; do
            [ "$cand" != "$WAN_IF" ] && { LAN_IF="$cand"; break; }
        done
    fi
    if [ "$have_db" -eq 1 ] && safe_dev "$WAN_IF" && safe_dev "$LAN_IF"; then
        sqlq "UPDATE interfaces SET physical_device='$WAN_IF' WHERE id='wan';"
        sqlq "UPDATE interfaces SET physical_device='$LAN_IF' WHERE id='lan';"
    fi
fi
mkdir -p /etc/micron
cat > /etc/micron/network_init.json <<EOF
{
  "wan_interface": "$WAN_IF",
  "lan_interface": "$LAN_IF",
  "configured": true
}
EOF
log "roles: WAN=${WAN_IF:-none} LAN=${LAN_IF:-none}"

# ------------------------------------------------- 2. generated artefacts
gen_files() {
    rm -rf "$WORK"; install -d -m 0750 "$WORK"
    if [ -f "$app_root/spark" ] && command -v php >/dev/null 2>&1; then
        (cd "$app_root" && php spark network boot-files "$WORK") >/dev/null 2>&1 && [ -s "$WORK/plan.json" ]
        return $?
    fi
    return 1
}

apply_plan() {
    local plan=""
    [ -s "$WORK/plan.json" ] && plan="$WORK/plan.json"
    if command -v python3 >/dev/null 2>&1 && [ -f "$NETCFG" ]; then
        python3 "$NETCFG" boot "$plan"
        return $?
    fi
    return 2
}

GENERATED=0
gen_files && GENERATED=1
[ "$GENERATED" -eq 1 ] || log "warning: could not build the plan from the database; using the last committed plan"

# ----------------------------------------------------------- 3. addressing
apply_plan
rc=$?
if [ "$rc" -eq 2 ]; then
    # No usable plan at all (first boot with a broken database): safe
    # defaults so the appliance stays reachable on the LAN. IPv6 stays off.
    log "warning: no network plan; falling back to factory LAN 10.10.10.10/24"
    if [ -n "$LAN_IF" ]; then
        ip link set dev "$LAN_IF" up 2>/dev/null || true
        ip addr replace 10.10.10.10/24 dev "$LAN_IF" 2>/dev/null || true
    fi
    if [ -n "$WAN_IF" ] && [ "$WAN_IF" != "$LAN_IF" ]; then
        ip link set dev "$WAN_IF" up 2>/dev/null || true
        command -v dhclient >/dev/null 2>&1 && dhclient -4 -nw -pf "/run/dhclient.${WAN_IF}.pid" "$WAN_IF" 2>/dev/null || true
    fi
fi

# --------------------------------------- 4. WAN/LAN subnet conflict repair
# A WAN lease inside the LAN subnet would black-hole the LAN. The LAN is
# moved through the same dependency-aware path as an operator change (DHCP
# pool, firewall/NAT references and DNS records follow), then re-applied.
if [ "$GENERATED" -eq 1 ] && [ -n "$WAN_IF" ] && [ "$WAN_IF" != "$LAN_IF" ]; then
    sleep 3
    wan_ip=$(ip -4 -o addr show dev "$WAN_IF" 2>/dev/null | awk '{print $4}' | grep -v '^169\.254' | head -n1 || true)
    lan_cidr=$(python3 -c "import json,sys;p=json.load(open('$WORK/plan.json'));print(next((i['ipv4'] or '') for i in p['interfaces'] if i['id']=='lan'))" 2>/dev/null || true)
    if [ -n "$wan_ip" ] && [ -n "$lan_cidr" ]; then
        if python3 - "$wan_ip" "$lan_cidr" <<'PY'
import ipaddress, sys
w = ipaddress.ip_interface(sys.argv[1]).network
l = ipaddress.ip_interface(sys.argv[2]).network
sys.exit(0 if w.overlaps(l) else 1)
PY
        then
            alt="192.168.10.1/24"
            python3 -c "import ipaddress,sys;sys.exit(0 if ipaddress.ip_interface('$wan_ip').network.overlaps(ipaddress.ip_network('192.168.10.0/24')) else 1)" && alt="172.31.254.1/24"
            log "WARNING: WAN address $wan_ip overlaps the LAN ($lan_cidr); moving the LAN to $alt"
            if (cd "$app_root" && php spark network set-address lan "$alt" --offline); then
                gen_files && apply_plan || true
            fi
        fi
    fi
fi

IPV6_ON=0
[ -s "$WORK/ipv6.enabled" ] && [ "$(cat "$WORK/ipv6.enabled")" = "1" ] && IPV6_ON=1
if [ "$GENERATED" -eq 0 ] && [ -r /proc/sys/net/ipv6/conf/all/disable_ipv6 ]; then
    [ "$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6)" = "0" ] && IPV6_ON=1
fi

# ------------------------------------------------------------- 5. DHCPv4
if [ "$GENERATED" -eq 1 ] && [ "$(cat "$WORK/dhcp4.enabled" 2>/dev/null)" = "1" ]; then
    if ! command -v kea-dhcp4 >/dev/null 2>&1 || kea-dhcp4 -t "$WORK/kea-dhcp4.conf" >/dev/null 2>&1; then
        install -d /etc/kea /var/lib/kea
        install -m 0600 "$WORK/kea-dhcp4.conf" /etc/kea/kea-dhcp4.conf
        systemctl restart --no-block kea-dhcp4-server 2>/dev/null || true
        log "DHCPv4 server configuration loaded from the database"
    else
        log "warning: generated DHCPv4 configuration rejected by kea-dhcp4 -t; keeping the previous one"
    fi
elif [ "$GENERATED" -eq 1 ]; then
    systemctl stop --no-block kea-dhcp4-server 2>/dev/null || true
fi
if [ "$IPV6_ON" -eq 0 ]; then
    systemctl stop --no-block kea-dhcp6-server radvd 2>/dev/null || true
fi

# -------------------------------------------------------------- 6. Unbound
# Base listener file owned by this script; the operator's resolver settings
# live in /etc/unbound/unbound.conf.d/micron.conf (DNS page → micrond).
mkdir -p /etc/unbound/unbound.conf.d
if [ -s /etc/unbound/unbound.conf.d/micron.conf ]; then
{
    echo "# Micron OS — the resolver is configured from the DNS page (unbound.conf.d/micron.conf)."
    echo "include-toplevel: \"/etc/unbound/unbound.conf.d/*.conf\""
} > /etc/unbound/unbound.conf.micron-new
else
{
    echo "# Micron OS — base resolver listener (generated by micron-network; IPv6 $( [ $IPV6_ON -eq 1 ] && echo on || echo off ))"
    echo "server:"
    echo "    verbosity: 1"
    echo "    interface: 0.0.0.0"
    [ "$IPV6_ON" -eq 1 ] && echo "    interface: ::0"
    echo "    port: 53"
    echo "    do-ip4: yes"
    echo "    do-ip6: $( [ $IPV6_ON -eq 1 ] && echo yes || echo no )"
    echo "    do-udp: yes"
    echo "    do-tcp: yes"
    echo "    access-control: 127.0.0.0/8 allow"
    echo "    access-control: 10.0.0.0/8 allow"
    echo "    access-control: 172.16.0.0/12 allow"
    echo "    access-control: 192.168.0.0/16 allow"
    echo "    access-control: 100.64.0.0/10 allow"
    if [ "$IPV6_ON" -eq 1 ]; then
        echo "    access-control: ::1/128 allow"
        echo "    access-control: fe80::/10 allow"
        echo "    access-control: fc00::/7 allow"
        echo "    access-control: 2000::/3 allow"
        echo "    access-control: ::0/0 refuse"
    fi
    echo "    access-control: 0.0.0.0/0 refuse"
    echo "    hide-identity: yes"
    echo "    hide-version: yes"
    echo "include-toplevel: \"/etc/unbound/unbound.conf.d/*.conf\""
} > /etc/unbound/unbound.conf.micron-new
fi
if ! command -v unbound-checkconf >/dev/null 2>&1 || unbound-checkconf /etc/unbound/unbound.conf.micron-new >/dev/null 2>&1; then
    mv -f /etc/unbound/unbound.conf.micron-new /etc/unbound/unbound.conf
    systemctl restart --no-block unbound 2>/dev/null || true
else
    log "warning: unbound rejected the generated base configuration; keeping the previous one"
    rm -f /etc/unbound/unbound.conf.micron-new
fi

# ------------------------------------------------------------- 7. Firewall
NFT_OK=0
if [ "$GENERATED" -eq 1 ] && command -v nft >/dev/null 2>&1 && nft -c -f "$WORK/nftables.conf" 2>/dev/null; then
    install -m 0644 "$WORK/nftables.conf" "$NFT_CONF"
    NFT_OK=1
fi
if [ "$NFT_OK" -eq 0 ] && [ ! -s "$NFT_CONF" ] && [ -n "$LAN_IF" ]; then
    # Last resort: minimal management-only ruleset (IPv6 dropped unless on).
    SSH_PORT=22
    WEB_PORT=443
    if [ "$have_db" -eq 1 ]; then
        db_ssh=$(sqlq "SELECT ssh_port FROM system_settings WHERE id=1 LIMIT 1;")
        [ -n "$db_ssh" ] && [ "$db_ssh" -gt 0 ] 2>/dev/null && SSH_PORT="$db_ssh"
        db_web=$(sqlq "SELECT webgui_port FROM system_settings WHERE id=1 LIMIT 1;")
        [ -n "$db_web" ] && [ "$db_web" -gt 0 ] 2>/dev/null && WEB_PORT="$db_web"
    fi
    v6rule='meta nfproto ipv6 drop comment "IPv6 disabled"'
    [ "$IPV6_ON" -eq 1 ] && v6rule='ip6 nexthdr icmpv6 accept'
    cat > "$NFT_CONF" <<EOF
#!/usr/sbin/nft -f
flush ruleset
table inet micron_filter {
    chain input {
        type filter hook input priority filter; policy drop;
        ct state established,related accept
        ct state invalid drop
        iifname "lo" accept
        $v6rule
        ip protocol icmp icmp type { echo-request, destination-unreachable, time-exceeded } limit rate 50/second accept
        iifname "$WAN_IF" udp dport 68 accept
        iifname "$LAN_IF" tcp dport { 80, 443, 22, $WEB_PORT, $SSH_PORT } accept
        iifname "$LAN_IF" udp dport { 53, 67 } accept
        iifname "$LAN_IF" tcp dport 53 accept
    }
    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state established,related accept
        iifname "$LAN_IF" accept
    }
    chain output { type filter hook output priority filter; policy accept; }
}
table inet micron_nat {
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "$WAN_IF" masquerade
    }
}
EOF
fi
nft -f "$NFT_CONF" 2>/dev/null || log "warning: nftables ruleset failed to load"

[ -x /usr/local/bin/micron-banner ] && /usr/local/bin/micron-banner 2>/dev/null || true
log "network initialised (IPv6 $( [ $IPV6_ON -eq 1 ] && echo on || echo off ))"
exit 0
