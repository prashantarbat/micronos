[Unit]
Description=Micron OS Dynamic SD-WAN SLA Probing Daemon (micron-sdwan-probe)
Documentation=https://github.com/micronos/micronos
After=network.target network-online.target micrond.service
Wants=micrond.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/micron-sdwan-probe
Restart=always
RestartSec=5s
KillMode=process
StandardOutput=journal
StandardError=journal
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
