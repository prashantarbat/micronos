def strict_loads(text: str) -> Any:
    def reject(name: str) -> Any:
        raise ValueError(f"non-standard JSON constant {name}")
    return json.loads(text, parse_constant=reject)


def load_config(path: str = CONFIG_PATH) -> Dict[str, Any]:
    cfg = dict(DEFAULTS)
    try:
        with open(path, "r", encoding="utf-8") as fh:
            data = strict_loads(fh.read())
        if isinstance(data, dict):
            for k, v in data.items():
                if k in DEFAULTS and type(v) is type(DEFAULTS[k]):
                    cfg[k] = v
    except FileNotFoundError:
        pass
    except (OSError, ValueError) as exc:
        log.warning("ignoring %s: %s", path, exc)
    return cfg


# =============================================================================
# Audit
# =============================================================================
class Audit:
    """Append-only JSON lines (0600, root). No terminal contents, ever."""

    def __init__(self, path: str):
        self.path = path
        try:
            os.makedirs(os.path.dirname(path), mode=0o750, exist_ok=True)
        except OSError:
            pass

    def __call__(self, event: str, **fields: Any) -> None:
        rec = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "event": event}
        rec.update({k: v for k, v in fields.items() if v is not None})
        line = json.dumps(rec, sort_keys=True, default=str)
        log.info("audit %s", line)
        try:
            fd = os.open(self.path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
            try:
                os.write(fd, (line + "\n").encode("utf-8"))
            finally:
                os.close(fd)
        except OSError as exc:
            log.error("audit write failed: %s", exc)


# =============================================================================
# Validation helpers
# =============================================================================
def valid_user_id(v: Any) -> bool:
    return isinstance(v, (str, int)) and 0 < len(str(v)) <= 64 and str(v).replace("-", "").replace("_", "").isalnum()


def valid_username(v: Any) -> bool:
    return isinstance(v, str) and 0 < len(v) <= 64 and all(c.isalnum() or c in "._@-" for c in v)


def normalise_origin(v: Any) -> Optional[str]:
    if not isinstance(v, str) or len(v) > 255:
        return None
    parts = urlsplit(v.strip())
    if parts.scheme not in ("http", "https") or not parts.hostname or parts.path not in ("", "/") or parts.query:
        return None
    port = parts.port
    default = 443 if parts.scheme == "https" else 80
    host = parts.hostname.lower()
    if ":" in host:
        host = f"[{host}]"
    return f"{parts.scheme}://{host}" + (f":{port}" if port and port != default else "")


def valid_ip(v: Any) -> bool:
    try:
        ipaddress.ip_address(str(v))
        return True
    except ValueError:
        return False


